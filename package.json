{
  "name": "motion-components-docs",
  "description": "Documentation site for motion-components — a library of web components built on the Motion animation library.",
  "type": "module",
  "private": true,
  "author": {
    "name": "tgomilar",
    "email": "tanja.gomilar@gmail.com"
