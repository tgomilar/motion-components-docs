  <script>
    import "motion-components/motion-circle";
    import "motion-components/motion-code-inline";
    import "motion-components/motion-counter";
    import "motion-components/motion-curve";
    import "motion-components/motion-flip-card";
    import "motion-components/motion-hover";
    import "motion-components/motion-icon";
    import "motion-components/motion-underline";
    import "motion-components/motion-strike";
    import "motion-components/motion-ring";
    import "motion-components/motion-marker";
    import "motion-components/motion-liquid";
    import "motion-components/motion-magnetic";
    import "motion-components/motion-press";
    import "motion-components/motion-reveal";
    import "motion-components/motion-scramble";
    import "motion-components/motion-sparkline";
    import "motion-components/motion-split";
    import "motion-components/motion-theme-icon";
    import "motion-components/motion-spotlight";
    import "motion-components/motion-stagger";
    import "motion-components/motion-stretch";
    import "motion-components/motion-swap";
    import "motion-components/motion-tilt";
    import "motion-components/motion-typewriter";
    import "motion-components/motion-words";
    import "motion-components/motion-blur-in";

    document.getElementById("replay-reveal")?.addEventListener("click", () => {
      (document.getElementById("reveal-demo") as any)?.replay();
    });

    document.getElementById("replay-stagger")?.addEventListener("click", () => {
      (document.getElementById("stagger-demo") as any)?.replay();
    });

    document.getElementById("replay-split")?.addEventListener("click", () => {
      (document.getElementById("split-demo") as any)?.replay();
    });

    document.getElementById("replay-counter")?.addEventListener("click", () => {
      (document.getElementById("counter-demo") as any)?.replay();
    });

    const swapDemo = document.getElementById("swap-demo");
    if (swapDemo && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let on = false;
      setInterval(() => {
        on = !on;
        swapDemo.dispatchEvent(new MouseEvent(on ? "mouseenter" : "mouseleave"));
      }, 1400);
    }
    document.querySelectorAll<HTMLElement & { trigger: string; animation: string }>("motion-icon[data-hover-animation]").forEach((icon) => {
      icon.addEventListener(
        "motion-finish",
        () => {
          icon.animation = icon.dataset.hoverAnimation ?? "draw";
          icon.trigger = "hover";
        },
        { once: true },
      );
    });

    const flipSpark = document.getElementById("flip-spark") as (HTMLElement & { values: string }) | null;
    if (flipSpark && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => {
        const values = flipSpark.values.split(",").map(Number);
        const next = Math.max(4, values[values.length - 1] + Math.round(Math.random() * 10 - 5));
        flipSpark.values = [...values.slice(1), next].join(", ");
      }, 1600);
    }

    type IconEl = HTMLElement & { src: string; icon: string; trigger: string; animation: string; delay: number; replay(): void };
    const iconCode = document.getElementById("icon-code") as (HTMLElement & { setCode(code: string): void }) | null;
    const iconPreview = document.getElementById("icon-preview") as IconEl | null;
    const iconPreviewName = document.getElementById("icon-preview-name");
    const tiles = [...document.querySelectorAll<HTMLButtonElement>("#icon-wall .icon-tile")];
    const lookOf = (tile: HTMLElement) => [...tile.classList].find((c) => c.startsWith("icon-tile--"))?.slice(11);

    const showIcon = (tile: HTMLButtonElement) => {
      const { name, src = "", animation = "draw", style = "", svg = "" } = tile.dataset;
      tiles.forEach((t) => t.setAttribute("aria-pressed", String(t === tile)));
      if (iconPreview) {
        iconPreview.icon = tile.querySelector("motion-icon svg")?.outerHTML ?? svg;
        iconPreview.src = "";
        iconPreview.animation = animation;
        iconPreview.setAttribute("style", style);
      }
      if (iconPreviewName) iconPreviewName.textContent = `${name} · ${animation} · ${lookOf(tile)}`;
      const styleAttr = style ? `\n  style="${style}"` : "";
      const script = `<script type="module" src="https://cdn.jsdelivr.net/npm/motion-components@1/dist/motion-icon.js/+esm"><\/script>\n\n`;
      iconCode?.setCode(
        svg
          ? `${script}<motion-icon\n  animation="${animation}"${styleAttr}\n>\n  ${svg.replace("><path", ">\n    <path").replace("</svg>", "\n  </svg>")}\n</motion-icon>`
          : `${script}<motion-icon\n  src="${src}"\n  animation="${animation}"${styleAttr}\n></motion-icon>`,
      );
    };

    customElements.whenDefined("motion-code").then(() => tiles[0] && showIcon(tiles[0]));

    type ModeEl = HTMLElement & { mode: string };
    const demoToggle = document.querySelector<ModeEl>("#home-theme-demo motion-theme-toggle");
    const demoIcon = document.getElementById("home-theme-icon") as ModeEl | null;
    const demoRows = document.getElementById("home-theme-rows") as (HTMLElement & { replay(): void }) | null;
    let demoMode = "";
    customElements.whenDefined("motion-theme-toggle").then(() => {
      demoMode = demoToggle?.mode ?? "";
      if (demoIcon && demoMode) demoIcon.mode = demoMode;
    });
    demoToggle?.addEventListener("colorschemechange", (event) => {
      const { mode } = (event as CustomEvent<{ mode: string }>).detail;
      if (demoIcon) demoIcon.mode = mode;
      if (demoMode && mode !== demoMode) demoRows?.replay();
      demoMode = mode;
    });

    tiles.forEach((tile) => {
      const icon = tile.querySelector<IconEl>("motion-icon")!;
      icon.addEventListener(
        "motion-finish",
        () => {
          icon.delay = 0;
          icon.animation = tile.dataset.animation ?? "draw";
          icon.trigger = "hover";
        },
        { once: true },
      );
      tile.addEventListener("click", () => {
        showIcon(tile);
        icon.replay();
      });
    });
  </script>

