---
import Layout from "../layouts/Layout.astro";
import CodeWindow from "../components/CodeWindow.astro";
import ArrowLink from "../components/ArrowLink.astro";

const ICON_COLS = 8;
const HEART_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>`;

const iconFiles = import.meta.glob<string>("../assets/home-icons/*.svg", { query: "?raw", import: "default", eager: true });

const MOBILE_ICONS = new Set(["heart", "bell", "rocket", "sun", "mail", "cake", "star", "gift", "puzzle-piece", "shield-check"]);

const iconStyle = (color?: string, look?: string, bg?: string) => {
  if (look === "solid") return `--mc-icon-color: ${color}; background: ${bg}; padding: 0.6rem; border-radius: 14px`;
  if (look === "tinted") return `--mc-icon-color: ${color}; --mc-icon-fill: ${color}4d`;
  return color ? `--mc-icon-color: ${color}` : "";
};

const iconWall = [
  ["heart", "pulse", "#e11d48", "tinted"], ["bell", "wiggle"], ["rocket", "bounce", "#ffffff", "solid", "#2563eb"], ["sun", "rotate", "#f59e0b", "tinted"], ["sparkles", "pop", "#facc15", "solid", "#1e40af"], ["academic-cap", "bounce", "#f59e0b", "filled"], ["mail", "draw"], ["music", "bounce", "#ffffff", "solid", "#3b82f6"],
  ["zap", "wiggle", "#eab308", "tinted"], ["camera", "pop"], ["cake", "bounce", "#ec4899", "filled"], ["cloud", "bounce", "#0ea5e9", "tinted"], ["moon", "rotate"], ["star", "pop", "#f59e0b", "tinted"], ["gift", "wiggle", "#1e40af", "solid", "#facc15"], ["coffee", "draw"],
  ["globe", "rotate", "#facc15", "solid", "#2563eb"], ["flame", "pulse", "#f97316", "tinted"], ["compass", "rotate"], ["puzzle-piece", "rotate", "#8b5cf6", "filled"], ["leaf", "wiggle", "#16a34a", "tinted"], ["anchor", "bounce"], ["light-bulb", "pulse", "#eab308", "filled"], ["feather", "draw"],
  ["umbrella", "pop", "#6366f1", "tinted"], ["key", "wiggle"], ["smile", "pop", "#eab308", "tinted"], ["thumbs-up", "bounce"], ["bug-ant", "wiggle", "#16a34a", "filled"], ["bookmark", "draw"], ["send", "bounce", "#ffffff", "solid", "#1d4ed8"], ["trash-2", "wiggle", "#ef4444"],
  ["settings", "rotate"], ["shield-check", "pop", "#10b981", "filled"], ["search", "pop"], ["house", "draw"], ["lock", "wiggle"], ["map-pin", "bounce", "#e11d48", "tinted"], ["beaker", "wiggle", "#06b6d4", "filled"], ["calendar", "draw"],
  ["clock", "rotate"], ["download", "bounce", "#facc15", "solid", "#1e40af"], ["message-circle", "pop"], ["shopping-cart", "bounce"], ["trophy", "pop", "#ca8a04", "tinted"], ["chart-pie", "rotate", "#2563eb", "filled"], ["flower-2", "rotate", "#2563eb", "solid", "#facc15"], ["palette", "wiggle", "#8b5cf6"],
].map(([name, animation, color, look, bg], i) => ({
  name,
  animation: animation === "draw" || look === "filled" ? animation : `draw ${animation}`,
  look: look ?? "outline",
  style: iconStyle(color, look, bg),
  tileStyle: look === "solid" ? `--mc-icon-color: ${color}; --tile-bg: ${bg}; background: ${bg}` : iconStyle(color, look),
  inline: i === 0,
  src: i === 0 ? "" : look === "filled" ? `https://cdn.jsdelivr.net/npm/heroicons@2/24/solid/${name}.svg` : `https://cdn.jsdelivr.net/npm/lucide-static@1/icons/${name}.svg`,
  svg: i === 0 ? HEART_SVG : iconFiles[`../assets/home-icons/${look === "filled" ? "heroicons" : "lucide"}-${name}.svg`],
  delay: ((i % ICON_COLS) + Math.floor(i / ICON_COLS)) * 0.06,
}));
---

<Layout
  title="Motion Components — Motion-first web components"
  description="Drop physics-based motion into any framework without rewriting your markup. Spring physics, interruptible animations, framework-agnostic web components built on Motion.">
  <!-- ── Hero ─────────────────────────────── -->
  <section class="hero">
    <div class="inner">
      <a href="/docs/" class="hero-circle" aria-label="Framework-agnostic motion components">
        <motion-circle text="INTERRUPT ME · I DARE YOU · " radius="120" duration="14" pause-on-hover>
          <motion-icon class="hero-circle-icon" set:html={iconFiles["../assets/home-icons/lucide-sparkle.svg"]} trigger="mount" duration="1" data-hover-animation="rotate"></motion-icon>
        </motion-circle>
      </a>
      <div class="hero-badge">Declarative motion <span class="hero-badge-dot">·</span> Spring physics <span class="hero-badge-dot">·</span> Interruptible</div>
      <h1>
        <motion-stretch text="Animate" spread="20" duration="1.11" bounce="0.75">Animate</motion-stretch>
        <span class="accent">
          <motion-stretch text="with HTML tags" spread="20" duration="1.11" bounce="0.75">with HTML tags</motion-stretch>
        </span>
      </h1>
      <p class="hero-sub">
      Declarative by default. A <motion-underline shape="wave" class="wave">JavaScript API</motion-underline> when you need it.<br />
      Physics-based motion for any framework. Built on <motion-underline shape="wave" class="wave">Motion</motion-underline>.
      </p>
      <div class="actions">
        <motion-hover>
          <a href="/docs/" class="btn-primary">Get started</a>
        </motion-hover>
        <motion-hover>
          <a href="https://github.com/tgomilar/motion-components" class="btn-ghost">View on GitHub</a>
        </motion-hover>
      </div>
      <div class="hero-install">
        <span class="install-label">Quick install</span>
        <motion-press><motion-code-inline copy-visible>npm install motion-components</motion-code-inline></motion-press>
      </div>
    </div>
  </section>

  <!-- ── Ticker ────────────────────────────── -->
  <section class="ticker-section">
    <motion-curve
      text="Spring physics · Physics-based · Zero CSS · Fully interruptible · TypeScript ready · Drop-in components · Framework-agnostic · Reduced motion support · Gesture-driven · Viewport-aware · No rewrites needed · Spring snap · Web Components standard ·"
      loop
      amplitude="22"
      wave-length="420"
      wave-duration="10"
      loop-gap="0"
      loop-speed="70"></motion-curve>

    <div class="inner ticker-caption">
      <p class="section-sub">
        <motion-press><motion-code-inline copy-visible>motion-curve</motion-code-inline></motion-press>smoothly looping text with wave animation
      </p>
    </div>
  </section>

  <!-- ── Usage ─────────────────────────────── -->
  <section class="usage-section">
    <div class="inner usage-inner">
      <div class="usage-text">
        <p class="section-eyebrow">How it works</p>
        <h2 class="usage-heading">
          One tag.<br />Works in <motion-words
            words="native HTML,React,Vue,Svelte,SolidJS,Alpine,Astro"
            colors="inherit, #61DAFB,#42B883,#FF3E00,#4F81C7,#77C1D2,#BC52EE"
            interval="3.6">native HTML</motion-words>.
        </h2>
        <p class="usage-sub">Drop a tag anywhere. No config, no wrappers, no boilerplate.</p>
        <ol class="steps">
          <motion-stagger interval="0.1" duration="0.65" y="24">
            <li>
              <span class="step-num">1</span>
              <div>
                <strong>Install</strong>
                <p>
                  Run <motion-code-inline copy-visible>npm install motion-components</motion-code-inline>, or load it from a CDN with one
                  script tag, as in the example.
                </p>
              </div>
            </li>
            <li>
              <span class="step-num">2</span>
              <div>
                <strong>Import once</strong>
                <p><motion-code-inline copy-visible>import 'motion-components'</motion-code-inline> registers all custom elements globally.</p>
              </div>
            </li>
            <li>
              <span class="step-num">3</span>
              <div>
                <strong>Wrap anything</strong>
                <p>
                  Compose <motion-code-inline>motion-hover</motion-code-inline>, <motion-code-inline>motion-reveal</motion-code-inline>, and friends around your
                  existing markup.
                </p>
              </div>
            </li>
          </motion-stagger>
        </ol>
      </div>

      <CodeWindow
        filename="example.html"
        copy
        code={`// 1. install
npm install motion-components

// or, with no build step, one tag in your HTML
<script type="module" src="https://cdn.jsdelivr.net/npm/motion-components@1/+esm"></script>

// 2. import once — works in any framework
import 'motion-components'

// 3. wrap anything
<motion-hover scale="1.1" y="-6">
  <button>Hover me</button>
</motion-hover>

<motion-reveal>
  <h2>Smooth entrance</h2>
</motion-reveal>

<motion-stagger>
  <div>One</div>
  <div>Two</div>
  <div>Three</div>
</motion-stagger>`}
      />
    </div>
  </section>

  <!-- ── Primitives ────────────────────────── -->
  <section class="primitives">
    <div class="inner">
      <div class="section-head">
        <p class="section-eyebrow">Primitives</p>
        <h2>Feel the difference.</h2>
        <p class="section-sub">Composable primitives. Each one is interactive. Try them.</p>
      </div>
    </div>
    <div class="inner inner--wide">
      <div class="demo-grid">
        <motion-stagger interval="0.09" duration="0.65" y="32">
          <a href="/docs/respond/motion-hover/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-hover</motion-code-inline>
              <div class="stage">
                <motion-hover scale="1.12" y="-8">
                  <div class="hover-chip">
                    <span class="chip-dot"></span>
                    Hover me
                  </div>
                </motion-hover>
              </div>
              <p class="card-desc">Spring scale and lift on hover</p>
            </div>
          </a>
          <a href="/docs/respond/motion-press/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-press</motion-code-inline>
              <div class="stage">
                <motion-press>
                  <button class="press-btn">Press me</button>
                </motion-press>
              </div>
              <p class="card-desc">Tactile spring compression on press</p>
            </div>
          </a>
          <a href="/docs/reveal/motion-reveal/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-reveal</motion-code-inline>
              <div class="stage stage--col">
                <motion-reveal id="reveal-demo" duration="0.75" y="28">
                  <div class="reveal-block">Fades into view</div>
                </motion-reveal>
                <button class="replay-btn" id="replay-reveal">↺ Replay</button>
              </div>
              <p class="card-desc">Fade and lift on viewport entry</p>
            </div>
          </a>
          <a href="/docs/reveal/motion-stagger/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-stagger</motion-code-inline>
              <div class="stage stage--col">
                <div class="stagger-wrap">
                  <motion-stagger id="stagger-demo" interval="0.1" duration="0.5">
                    <div class="stagger-row">Design</div>
                    <div class="stagger-row">Develop</div>
                    <div class="stagger-row">Delight</div>
                  </motion-stagger>
                </div>
                <button class="replay-btn" id="replay-stagger">↺ Replay</button>
              </div>
              <p class="card-desc">Sequence children in on scroll entry</p>
            </div>
          </a>
          <a href="/docs/respond/motion-magnetic/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-magnetic</motion-code-inline>
              <div class="stage">
                <motion-magnetic strength="0.5">
                  <button class="press-btn">Move over me</button>
                </motion-magnetic>
              </div>
              <p class="card-desc">Element attracted to cursor with spring</p>
            </div>
          </a>
          <a href="/docs/respond/motion-tilt/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-tilt</motion-code-inline>
              <div class="stage">
                <motion-tilt max="18">
                  <div class="tilt-card">
                    <span class="tilt-label">Tilt me</span>
                  </div>
                </motion-tilt>
              </div>
              <p class="card-desc">3D perspective tilt following cursor</p>
            </div>
          </a>
        </motion-stagger>
      </div>
    </div>
  </section>

  <!-- ── Text effects ──────────────────────── -->
  <section class="text-section">
    <div class="inner">
      <div class="section-head">
        <p class="section-eyebrow">Text Effects</p>
        <h2>Words in motion.</h2>
        <p class="section-sub">Components for animated text: split, typewriter, counter, rotating words, swaps, and marks that draw onto words.</p>
      </div>
    </div>
    <div class="inner inner--wide">
      <div class="text-grid">
        <motion-stagger interval="0.1" duration="0.65" y="24">
          <a href="/docs/text/motion-typewriter/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-typewriter</motion-code-inline>
              <div class="stage">
                <motion-typewriter id="tw-demo" interval="0.055" loop cursor class="typewriter-text"> Motion that feels alive. </motion-typewriter>
              </div>
            </div>
          </a>
          <a href="/docs/text/motion-counter/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-counter</motion-code-inline>
              <div class="stage">
                <div class="counter-row">
                  <motion-counter id="counter-demo" from="0" to="122" duration="1.8" suffix="k" class="counter-num">122k</motion-counter>
                  <span class="counter-label">users</span>
                </div>
              </div>
              <div class="replay-row">
                <button class="replay-btn" id="replay-counter">↺ Replay</button>
              </div>
            </div>
          </a>
          <a href="/docs/text/motion-scramble/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-scramble</motion-code-inline>
              <div class="stage">
                <motion-scramble id="scramble-demo" interval="0.035" delay="1" loop class="scramble-text"> Creativity! </motion-scramble>
              </div>
              <p class="card-hint">Loop scramble</p>
            </div>
          </a>
          <a href="/docs/text/motion-words/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-words</motion-code-inline>
              <div class="stage">
                <p class="words-demo-text">
                  We
                  <motion-words words="design,build,ship" colors="#3b82f6,#8b5cf6,#10b981" interval="1.6"></motion-words>
                  fast.
                </p>
              </div>
              <p class="card-hint">Cycle words with per-word color</p>
            </div>
          </a>
          <a href="/docs/text/motion-swap/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-swap</motion-code-inline>
              <div class="stage">
                <motion-swap id="swap-demo" interval="0.04" class="swap-text">Smooth swaps</motion-swap>
              </div>
              <p class="card-hint">Swaps on a loop</p>
            </div>
          </a>
          <a href="/docs/text/motion-marker/" class="card-link">
            <div class="card">
              <motion-code-inline>motion-marker</motion-code-inline>
              <div class="stage">
                <p class="marks-text">
                  <motion-ring>Draw attention</motion-ring><br />
                  to <motion-marker loop pause-on-hover delay="0.7">what matters</motion-marker>,<br />
                  <motion-underline shape="wave" delay="0.8" class="marks-wave">not</motion-underline>
                  <motion-strike delay="1.2" class="marks-strike">everything</motion-strike>.
                </p>
              </div>
              <p class="card-hint">Marker, underline, strike and ring</p>
            </div>
          </a>
        </motion-stagger>
      </div>
      <div class="inner">
        <ArrowLink href="/docs/#text" class="view-all-link">View all text effects</ArrowLink>
      </div>
    </div>
  </section>

  <!-- ── New: theme toggle ─────────────────── -->
  <section class="theme-section">
    <div class="inner">
      <div class="section-head">
        <p class="section-eyebrow">Theming</p>
        <h2>Light, dark, and system.</h2>
        <p class="section-sub">
          <code>&lt;motion-theme-toggle&gt;</code> switches themes with a spring sun-to-moon morph, and an optional circular wipe from the control.
        </p>
      </div>
      <div class="theme-showcase">
        <motion-reveal y="32" duration="0.8">
          <motion-tilt max="4" scale="1" class="theme-tilt">
            <motion-spotlight size="360" class="theme-spot">
              <div class="theme-demo" id="home-theme-demo">
                <div class="theme-demo-head">
                  <span class="theme-demo-title"><motion-theme-icon id="home-theme-icon" mode="system"></motion-theme-icon>Inbox</span>
                  <motion-theme-toggle target="#home-theme-demo" appearance="toggle" system></motion-theme-toggle>
                </div>
                <motion-stagger id="home-theme-rows" interval="0.08" y="10">
                  <div class="theme-demo-row"><span class="theme-demo-dot"></span>Release notes are ready for review</div>
                  <div class="theme-demo-row"><span class="theme-demo-dot"></span>Design sync moved to Thursday</div>
                  <div class="theme-demo-row"><span class="theme-demo-dot"></span>3 new comments on the roadmap</div>
                </motion-stagger>
              </div>
            </motion-spotlight>
          </motion-tilt>
        </motion-reveal>
        <ul class="theme-points">
          <motion-stagger interval="0.1" y="16">
            <li><motion-icon trigger="view" set:html={iconFiles["../assets/home-icons/lucide-palette.svg"]}></motion-icon><span><strong>Four looks:</strong> icon, segmented toggle, switch and drop-down menu.</span></li>
            <li><motion-icon trigger="view" set:html={iconFiles["../assets/home-icons/lucide-history.svg"]}></motion-icon><span><strong>Remembers the choice</strong> and follows the OS setting when set to system.</span></li>
            <li><motion-icon trigger="view" set:html={iconFiles["../assets/home-icons/lucide-puzzle.svg"]}></motion-icon><span><strong>Drop-in compatible</strong> with Chrome Labs' <code>dark-mode-toggle</code> attributes and events.</span></li>
            <li><motion-icon trigger="view" set:html={iconFiles["../assets/home-icons/lucide-mouse-pointer-click.svg"]}></motion-icon><span><strong>Try the header:</strong> the theme menu on this site is the same component.</span></li>
            <li class="theme-points-link"><ArrowLink href="/docs/components/motion-theme-toggle/" class="view-all-link">Read the docs</ArrowLink></li>
          </motion-stagger>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Icons ─────────────────────────────── -->
  <section class="icons-section">
    <div class="inner">
      <div class="section-head">
        <p class="section-eyebrow">Animated icons</p>
        <h2>Icons that move.</h2>
        <p class="section-sub">
          <motion-code-inline>&lt;motion-icon&gt;</motion-code-inline> draws in, pops or wiggles any SVG icon from Lucide, Tabler, Heroicons, Material
          Symbols, Font Awesome and more. <motion-code-inline>&lt;motion-icon-state&gt;</motion-code-inline> morphs between two states on a spring.
        </p>
      </div>
      <div class="icons-showcase">
        <div class="icon-wall" id="icon-wall" style={`--cols: ${ICON_COLS}`}>
          {iconWall.map((icon, i) => (
            <button
              class={`icon-tile icon-tile--${icon.look}${MOBILE_ICONS.has(icon.name) ? "" : " icon-tile--extra"}`}
              type="button"
              aria-label={icon.name}
              aria-pressed={i === 0 ? "true" : "false"}
              data-name={icon.name}
              data-src={icon.src}
              data-animation={icon.animation}
              data-style={icon.style}
              data-svg={icon.inline ? HEART_SVG : undefined}
              style={icon.tileStyle || undefined}
            >
              <motion-icon trigger="view" animation={icon.animation} delay={icon.delay} duration="0.8" set:html={icon.svg}></motion-icon>
            </button>
          ))}
        </div>
        <div class="icon-inspector">
          <div class="icon-preview">
            <motion-icon id="icon-preview" icon={HEART_SVG} animation={iconWall[0].animation} trigger="loop" interval="0.9" style={iconWall[0].style}></motion-icon>
            <span id="icon-preview-name">{iconWall[0].name} · {iconWall[0].animation} · {iconWall[0].look}</span>
          </div>
          <motion-code id="icon-code" filename="index.html" copy copy-label compact></motion-code>
        </div>
      </div>
      <p class="icons-hint">Hover the icons. Click one to preview it and copy its code.</p>
      <div class="icons-links">
        <ArrowLink href="/docs/icons/motion-icon/" class="view-all-link">motion-icon docs</ArrowLink>
        <ArrowLink href="/docs/icons/motion-icon-state/" class="view-all-link">motion-icon-state docs</ArrowLink>
      </div>
    </div>
  </section>

  <!-- ── Features ──────────────────────────── -->
  <section class="features-section">
    <div class="inner">
      <div class="section-head">
        <p class="section-eyebrow">Why motion-components</p>
        <h2>Built different.</h2>
      </div>
    </div>
    <div class="inner">
      <div class="features-grid">
        <motion-stagger interval="0.07" duration="0.6" y="20">
          <motion-hover scale="1.02" y="-4">
            <div class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg
                >
              </div>
              <h3>Spring physics</h3>
              <p>Every animation uses spring dynamics: naturally interruptible, with no jarring cuts.</p>
            </div>
          </motion-hover>
          <motion-hover scale="1.02" y="-4">
            <div class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg
                >
              </div>
              <h3>Framework-agnostic</h3>
              <p>Standard web components work anywhere: React, Vue, Svelte, Astro, or raw HTML. No adapter needed.</p>
            </div>
          </motion-hover>
          <motion-hover scale="1.02" y="-4">
            <div class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"
                  ></rect><path d="M14 17.5h3m3 0h-3m0 0v-3m0 3v3"></path></svg
                >
              </div>
              <h3>Composable primitives</h3>
              <p>
                Build complex interactions by wrapping: nest <motion-code-inline>motion-hover</motion-code-inline> inside <motion-code-inline
                  >motion-stagger</motion-code-inline
                > effortlessly.
              </p>
            </div>
          </motion-hover>
          <motion-hover scale="1.02" y="-4">
            <div class="feature">
              <div class="feature-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
                >
              </div>
              <h3>Zero config</h3>
