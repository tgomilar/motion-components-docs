---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(date);

const readingTime = (body: string) => Math.max(1, Math.round(body.split(/\s+/).length / 200));
---

<Layout
  title="Blog — Motion Components"
  description="Articles and guides on building animation with motion-components — springs, web components, and design-to-code workflows."
  keywords="motion-components blog, web animation guides, spring animation tutorials, web components animation">
  <div class="blog-wrap">
    <header class="blog-hero">
      <p class="eyebrow">Blog</p>
      <h1>Guides &amp; articles</h1>
      <p class="lead">
        Practical writing on shipping motion — from Figma handoffs to spring physics to accessible
        animation, all built with <motion-code-inline copy-visible>motion-components</motion-code-inline>.
      </p>
    </header>

    <motion-stagger interval="0.09" class="post-list">
      {
        posts.map(post => (
          <motion-hover scale="1.02" duration="0.3">
            <a class="post-card" href={`/blog/${post.id}/`}>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span class="dot" aria-hidden="true">·</span>
                <span>{readingTime(post.body ?? "")} min read</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <span class="read-more">Read article →</span>
            </a>
          </motion-hover>
        ))
      }
    </motion-stagger>
  </div>

  <script>
    import "motion-components";
  </script>

  <style>
    .blog-wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 5rem 2rem 6rem;
    }

    .eyebrow {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--color-accent);
      margin-bottom: 1rem;
    }

    h1 {
      font-size: clamp(2.4rem, 6vw, 3.4rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.05;
      margin-bottom: 1.25rem;
    }

    .lead {
      font-size: 1.05rem;
      color: var(--color-muted);
      line-height: 1.75;
    }

    .post-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 3.5rem;
    }

    .post-card {
      display: block;
      padding: 1.5rem 1.75rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      color: var(--color-text);
      text-decoration: none;
      transition: border-color 0.2s;
    }

    .post-card:hover {
      border-color: var(--color-accent);
      text-decoration: none;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--color-muted);
      margin-bottom: 0.6rem;
    }

    .post-card h2 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    .post-card p {
      font-size: 0.92rem;
      color: var(--color-muted);
      line-height: 1.65;
      margin-bottom: 0.9rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.9rem;
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--color-accent);
      background: var(--color-accent-dim);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }

    .read-more {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-accent);
    }

    @media (max-width: 640px) {
      .blog-wrap {
        padding: 3.5rem 1.25rem 4rem;
      }

      .post-card {
        padding: 1.25rem;
      }
    }
  </style>
</Layout>
