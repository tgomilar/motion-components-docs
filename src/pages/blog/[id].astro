---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(date);

const readingTime = Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 200));

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: post.data.author,
    url: "https://github.com/tgomilar"
  },
  publisher: {
    "@type": "Organization",
    name: "Motion Components",
    url: "https://www.motion-components.dev"
  },
  url: Astro.url.href,
  image: new URL(`/og/blog/${post.id}.png`, Astro.url.origin).href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  keywords: post.data.tags.join(", "),
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "Motion Components",
    url: "https://www.motion-components.dev"
  }
});
---

<Layout title={`${post.data.title} — Motion Components`} description={post.data.description} ogType="article" author={post.data.author}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
  <meta property="article:modified_time" content={post.data.pubDate.toISOString()} />
  <meta property="article:author" content={post.data.author} />
  <meta property="article:section" content="Technology" />
  <meta property="article:tag" content={post.data.tags.join(", ")} />
  <meta name="twitter:label1" content="Reading time" />
  <meta name="twitter:data1" content={`${readingTime} min read`} />
  <meta name="twitter:label2" content="Tags" />
  <meta name="twitter:data2" content={post.data.tags.join(", ")} />
  <meta name="ai-content-declaration" content="human-authored" />
  <article class="post-wrap">
    <header class="post-header">
      <a class="back-link" href="/blog/" data-pagefind-ignore>← All articles</a>
      <h1>{post.data.title}</h1>
      <div class="post-meta" data-pagefind-ignore="all">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
        {
          post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span class="tags">
                {post.data.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer" data-pagefind-ignore="all">
      <a class="back-link" href="/blog/" data-pagefind-ignore>← All articles</a>
    </footer>
  </article>

  <script>
    import "motion-components";
  </script>

  <style>
    .post-wrap {
      max-width: 720px;
      margin: 0 auto;
      padding: 4rem 2rem 6rem;
    }

    .post-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    .back-link {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--color-muted);
      margin-bottom: 1.5rem;
    }

    .back-link:hover {
      color: var(--color-accent);
      text-decoration: none;
    }

    h1 {
      font-size: clamp(1.9rem, 4.5vw, 2.7rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.12;
      margin-bottom: 1rem;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--color-muted);
    }

    .tags {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--color-accent);
      background: var(--color-accent-dim);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }

    /* ── Prose (rendered markdown) ─────────── */
    .prose {
      font-size: 0.97rem;
      line-height: 1.75;
      color: var(--color-muted);
    }

    .prose :global(h2) {
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--color-text);
      margin: 2.75rem 0 0.75rem;
      line-height: 1.25;
    }

    .prose :global(h3) {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 2rem 0 0.5rem;
    }

    .prose :global(p) {
      margin-bottom: 1rem;
    }

    .prose :global(strong) {
      color: var(--color-text);
    }

    .prose :global(ul),
    .prose :global(ol) {
      padding-left: 1.35rem;
      margin: 0.75rem 0 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .prose :global(code:not(pre code)) {
      font-family: var(--font-mono);
      font-size: 0.85em;
      color: var(--color-accent);
      background: var(--color-accent-dim);
      padding: 0.1em 0.4em;
      border-radius: 4px;
    }

    .prose :global(motion-code) {
      display: block;
      margin: 1.1rem 0 1.5rem;
    }

    .prose :global(pre) {
      margin: 1.1rem 0 1.5rem;
      padding: 1.1rem 1.25rem;
      border-radius: 10px;
      border: 1px solid var(--color-border);
      font-size: 0.84rem;
      line-height: 1.65;
      overflow-x: auto;
    }

    .prose :global(pre code) {
      font-family: var(--font-mono);
    }

    .prose :global(a) {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
      text-underline-offset: 0.2em;
      transition: text-decoration-color 0.15s;
    }

    .prose :global(a:hover) {
      text-decoration-color: var(--color-accent);
    }

    .prose :global(a[target="_blank"])::after {
      content: " \2197";
      font-size: 0.8em;
      opacity: 0.6;
    }

    .prose :global(strong a) {
      font-weight: 600;
    }

    /* Markdown tables, styled to match the docs' PropsTable component */
    .prose :global(.md-table) {
      border: 1px solid var(--color-border);
      border-radius: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      max-width: 100%;
      margin: 1.1rem 0 1.5rem;
    }

    .prose :global(.md-table table) {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      background: var(--color-surface);
    }

    .prose :global(.md-table th) {
      text-align: left;
      padding: 0.65rem 1rem;
      background: var(--color-surface-2);
      color: var(--color-muted);
      font-weight: 600;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid var(--color-border);
      white-space: nowrap;
    }

    .prose :global(.md-table td) {
      padding: 0.65rem 1rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text);
      transition: background 0.15s;
    }

    .prose :global(.md-table tr:nth-child(even) td) {
      background: color-mix(in srgb, var(--color-surface-2) 45%, transparent);
    }

    .prose :global(.md-table tbody tr:hover td) {
      background: var(--color-accent-dim);
    }

    .prose :global(.md-table tr:last-child td) {
      border-bottom: none;
    }

    .prose :global(blockquote) {
      position: relative;
      padding: 0.05rem 0 0.05rem 1.4rem;
      margin: 2rem 0;
      font-size: 1.2rem;
      font-weight: 600;
    }

    .prose :global(blockquote p) {
      margin: 0;
    }

    .prose :global(blockquote)::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 3px;
      height: 100%;
      background: var(--color-accent);
      border-radius: 999px;
    }

    .prose :global(hr) {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 2.5rem 0;
    }

    .prose :global(img) {
      max-width: 100%;
      border-radius: 10px;
    }

    .post-footer {
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .post-footer .back-link {
      margin-bottom: 0;
    }

    @media (max-width: 640px) {
      .post-wrap {
        padding: 3rem 1.25rem 4rem;
      }
    }
  </style>
</Layout>
