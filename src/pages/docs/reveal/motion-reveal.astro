---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-reveal — Motion Components" description="Animates its content in when it enters the viewport. Uses IntersectionObserver with spring-based fade and lift." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-reveal</motion-split></h1>
      <p class="lead">Animates its content in when it enters the viewport. Uses IntersectionObserver with spring-based fade and lift.</p>

      <h2>Preview</h2>
      <DocsPreview replayId="reveal-demo">
        <motion-reveal id="reveal-demo" duration="0.6" y="24">
          <div class="demo-card">Scroll to reveal</div>
        </motion-reveal>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-reveal'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <CodeWindow
        filename="motion-reveal.html"
        copy
        code={`<motion-reveal duration="0.6" y="24">
  <h2>Fades into view</h2>
</motion-reveal>`}
      />

      <h2 id="sequence-with-delay">Sequence with delay</h2>
      <p>Give each reveal a different <code>delay</code> to bring a block in one piece after another.</p>
      <DocsPreview replayId="reveal-sequence">
        <div class="demo-sequence" id="reveal-sequence">
          <motion-reveal><div class="seq-title">Motion that feels alive</div></motion-reveal>
          <motion-reveal delay="0.15"><p class="seq-text">Spring-based components for the web.</p></motion-reveal>
          <motion-reveal delay="0.3"><span class="seq-button">Get started</span></motion-reveal>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-reveal-sequence.html"
        copy
        code={`<motion-reveal>
  <h2>Motion that feels alive</h2>
</motion-reveal>
<motion-reveal delay="0.15">
  <p>Spring-based components for the web.</p>
</motion-reveal>
<motion-reveal delay="0.3">
  <a href="/docs">Get started</a>
</motion-reveal>`}
      />

      <h2>Properties</h2>
      <PropsTable
        nameLabel="Attribute"
        rows={[
          { name: "duration", type: "number", default: "0.6", description: "Spring duration hint in seconds" },
          { name: "delay", type: "number", default: "0", description: "Seconds to wait before the reveal starts. Set different values on several reveals to bring them in one after another" },
          { name: "y", type: "number", default: "24", description: "Initial vertical offset in px" },
          { name: "threshold", type: "number", default: "0.1", description: "IntersectionObserver visibility threshold (0–1)" },
          { name: "once", type: "boolean", default: "true", description: "Animate only on first intersection. Set it to <code>\"false\"</code> to replay on every entry" },
        ]}
      />
      <h2>JavaScript API</h2>
      <p class="section-desc">Trigger the reveal programmatically with <code>play()</code>, <code>cancel()</code>, and <code>replay()</code>.</p>
      <JsApiDemo target="api-reveal-demo" mode="one-shot" wide>
        <motion-reveal id="api-reveal-demo" duration="0.6" y="32">
          <div class="demo-card">Reveal from JavaScript</div>
        </motion-reveal>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>Respects <code>prefers-reduced-motion</code>: when enabled, the reveal animation is skipped and content appears immediately at its final state.</p>
      <DocsPagination />
    </main>
    <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-reveal";
  import "motion-components/motion-split";
</script>

<style>
  .demo-card {
    background: var(--mc-color-surface-2);
    border: 1px solid var(--mc-color-border);
    border-radius: 10px;
    padding: 2rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--mc-color-text);
    text-align: center;
  }

  .demo-sequence {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .seq-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--mc-color-text);
  }

  .seq-text {
    margin: 0;
    color: var(--mc-color-muted);
  }

  .seq-button {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    background: var(--mc-color-accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
