---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-scramble — Motion Components" description="Scrambles text with random characters then progressively reveals the real text from left to right. Trigger on scroll or on hover." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-scramble</motion-split></h1>
      <p class="lead">Scrambles text with random characters then progressively reveals the real text from left to right. Trigger on scroll or on hover.</p>

      <h2>Preview</h2>
      <DocsPreview replayId="scramble-demo">
        <motion-scramble id="scramble-demo" interval="0.04" iterations="2" class="demo-text"> Hello, world. </motion-scramble>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-scramble'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <CodeWindow
        filename="motion-scramble.html"
        copy
        code={`<motion-scramble trigger="hover">
  Hover to scramble
</motion-scramble>`}
      />

      <h2>Loop</h2>
      <p>
        Add <code>loop</code> to decode the text, hold, then scramble it again. <code>hold</code> sets how long the
        resolved text stays readable, <code>gap</code> how long it rests before the next decode.
      </p>
      <DocsPreview replayId="scramble-loop">
        <p class="sentence">
          Status: <motion-scramble id="scramble-loop" interval="0.04" loop hold="1.6" gap="0.6"
            >SYSTEM_ONLINE</motion-scramble
          >
        </p>
      </DocsPreview>
      <CodeWindow
        filename="motion-scramble-loop.html"
        copy
        code={`<motion-scramble interval="0.04" loop hold="1.6" gap="0.6">SYSTEM_ONLINE</motion-scramble>`}
      />
      <p>
        With <motion-code-inline copy>trigger="view"</motion-code-inline> the cycle runs only while the text is on screen,
        and <code>once</code> is ignored. Add <code>pause-on-hover</code> to freeze it while the pointer is over the text.
      </p>

      <h2>Properties</h2>
      <PropsTable nameLabel="Attribute" rows={[
        { name: 'interval', type: 'number', default: '0.04', description: 'Time between scramble frames, in seconds' },
        { name: 'delay', type: 'number', default: '0', description: 'Delay before starting, in seconds' },
        { name: 'iterations', type: 'number', default: '2', description: 'Scramble frames per character before revealing' },
        { name: 'trigger', type: 'string', default: "'view'", description: "What starts the scramble: <code>'view'</code> on viewport entry or <code>'hover'</code> on mouseenter" },
        { name: 'once', type: 'boolean', default: 'true', description: 'Animate only on first intersection. Set <motion-code-inline copy>once="false"</motion-code-inline> to animate on every entry. Ignored with <code>loop</code>' },
        { name: 'loop', type: 'boolean', default: 'false', description: 'Decode, hold, then scramble again on repeat. With <motion-code-inline copy>trigger="view"</motion-code-inline> the cycle runs while the text is on screen' },
        { name: 'hold', type: 'number', default: '1.6', description: 'With <code>loop</code>, seconds the resolved text stays readable before it scrambles again' },
        { name: 'gap', type: 'number', default: '0.5', description: 'With <code>loop</code>, seconds between cycles, while the text is already resolved' },
        { name: 'pause-on-hover', type: 'boolean', default: 'false', description: 'Pause the loop while the pointer is over the text, resuming on leave' },
      ]} />
      <h2>JavaScript API</h2>
      <p class="section-desc">Trigger the scramble programmatically with <code>play()</code> and <code>cancel()</code>.</p>
      <JsApiDemo target="api-scramble-demo" mode="one-shot" wide>
        <motion-scramble id="api-scramble-demo">JavaScript API</motion-scramble>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>Respects <code>prefers-reduced-motion</code>: when enabled, the scramble effect is skipped, the text appears at its final state immediately and <code>loop</code> never starts.</p>
      <DocsPagination />
    </main>
      <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-scramble";
  import "motion-components/motion-split";
</script>

<style>
  .demo-text {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--mc-color-text);
    font-family: var(--font-mono);
  }
</style>
