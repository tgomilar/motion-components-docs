---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-perspective — Motion Components" description="Scales characters progressively to simulate a vanishing-point perspective: text that recedes into the distance. Static by default, with an optional animated rotation mode." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-perspective</motion-split></h1>
      <p class="lead">Scales characters progressively to simulate a vanishing-point perspective: text that recedes into the distance. Static by default, with an optional animated rotation mode.</p>

      <h2>Preview</h2>
      <DocsPreview>
        <motion-perspective class="demo-large" depth="0.7" vanish="left">PERSPECTIVE</motion-perspective>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-perspective'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <h3>Static content</h3>
      <p>Write the text as a child. The browser shows it as plain text before the element is defined, so the page never paints an empty gap while the library loads.</p>
      <CodeWindow
        filename="motion-perspective.html"
        copy
        code={`<motion-perspective depth="0.7" vanish="left">
  PERSPECTIVE
</motion-perspective>`}
      />

      <h3>Dynamic content</h3>
      <p>Use the <code>text</code> attribute when text changes at runtime. Setting the property restarts the animation automatically.</p>
      <CodeWindow
        filename="app.ts"
        copy
        code={`const el = document.querySelector('motion-perspective')
el.text = 'UPDATED'   // animation restarts`}
      />
      <p>
        If both are present, the attribute wins and the child text stays as the pre-upgrade fallback.
      </p>

      <h2>Vanish right</h2>
      <p>Set <motion-code-inline copy>vanish="right"</motion-code-inline> to flip the direction: text grows from left to right.</p>
      <DocsPreview>
        <motion-perspective class="demo-large" depth="0.7" vanish="right">RECEDING</motion-perspective>
      </DocsPreview>
      <CodeWindow
        filename="motion-perspective.html"
        copy
        code={`<motion-perspective depth="0.7" vanish="right">
  RECEDING
</motion-perspective>`}
      />

      <h2>Depth</h2>
      <p>Increase <code>depth</code> toward <code>1</code> for a more extreme effect, or reduce it for a subtle optical refinement.</p>
      <DocsPreview>
        <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start">
          <motion-perspective class="demo-large" depth="0.3" vanish="left">SHALLOW</motion-perspective>
          <motion-perspective class="demo-large" depth="0.85" vanish="left">DEEP</motion-perspective>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-perspective.html"
        copy
        code={`<motion-perspective depth="0.3" vanish="left">SHALLOW</motion-perspective>
<motion-perspective depth="0.85" vanish="left">DEEP</motion-perspective>`}
      />

      <h2>loop</h2>
      <p>
        Add <code>loop</code> to continuously rotate the perspective illusion back and forth. <code>duration</code> sets
        the seconds per cycle. Lower is faster. The old <code>oscillate</code> attribute still works as an alias for
        <code>loop</code>.
      </p>
      <DocsPreview>
        <motion-perspective class="demo-large" depth="0.7" vanish="left" loop duration="1.667">ROTATING</motion-perspective>
      </DocsPreview>
      <CodeWindow
        filename="motion-perspective.html"
        copy
        code={`<motion-perspective depth="0.7" loop duration="1.667">
  ROTATING
</motion-perspective>`}
      />

      <h2>Pause on hover</h2>
      <p>Add <code>pause-on-hover</code> to freeze the animation when the cursor enters.</p>
      <DocsPreview>
        <motion-perspective class="demo-large" depth="0.7" loop duration="2" pause-on-hover>HOVER ME</motion-perspective>
      </DocsPreview>
      <CodeWindow
        filename="motion-perspective.html"
        copy
        code={`<motion-perspective depth="0.7" loop duration="2" pause-on-hover>
  HOVER ME
</motion-perspective>`}
      />

      <h2>How it works</h2>
      <p>
        Characters are laid out in a bottom-aligned flex row. Each character's <code>font-size</code> is scaled from <code>(1 - depth)em</code> at the vanishing end to <code>1em</code> at the foreground end. Because all characters share the same baseline, the result mimics text on a flat plane receding into the distance.
      </p>
      <p>
        In loop mode, a <code>requestAnimationFrame</code> cycle drives a cosine wave across the character positions, continuously cycling the perspective illusion through a full rotation.
      </p>

      <h2>Properties</h2>
      <PropsTable nameLabel="Attribute" rows={[
        { name: 'text', type: 'string', default: '—', description: 'Text to render with the perspective effect. Falls back to the child text when unset' },
        { name: 'depth', type: 'number', default: '0.65', description: 'Effect intensity: how small the vanishing end gets (0–1)' },
        { name: 'vanish', type: 'string', default: "'left'", description: "Which end of the text is the vanishing point: <code>'left'</code> or <code>'right'</code>" },
        { name: 'loop', type: 'boolean', default: 'false', description: 'Continuously rotate the perspective back and forth. <code>oscillate</code> is kept as an alias' },
        { name: 'duration', type: 'number', default: '0.667', description: 'Seconds per rotation cycle. Lower is faster (only applies when <code>loop</code> is set)' },
        { name: 'pause-on-hover', type: 'boolean', default: 'false', description: 'Freeze animation on mouseenter, resume on mouseleave' },
      ]} />

      <h2>JavaScript API</h2>
      <p class="section-desc">Control the perspective programmatically with <code>play()</code>, <code>pause()</code>, <code>finish()</code>, and <code>cancel()</code>.</p>
      <JsApiDemo target="api-perspective-demo" wide>
        <motion-perspective id="api-perspective-demo" text="JS API" loop duration="2">
        </motion-perspective>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>
        When <code>prefers-reduced-motion</code> is set, <code>loop</code> falls back to the static perspective layout.
      </p>
      <DocsPagination />
    </main>
      <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-perspective";
  import "motion-components/motion-split";
</script>

<style>
  .demo-large {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--mc-color-accent);
  }
</style>
