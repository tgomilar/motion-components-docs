---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-underline — Motion Components" description="A line that draws itself under a phrase, left to right, when it scrolls into view or on hover. Follows text that wraps." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-underline</motion-split></h1>
      <p class="lead">A line that draws itself under a phrase, from left to right, when it scrolls into view or on hover. Straight, dashed and dotted lines follow text that wraps across lines; <code>shape="wave"</code> draws a wavy line. It uses the text color unless you set another.</p>

      <h2>Preview</h2>
      <DocsPreview replayId="underline-demo">
        <p class="sentence">Interactions that <motion-underline id="underline-demo">feel right</motion-underline>.</p>
      </DocsPreview>
      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-underline'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <CodeWindow filename="index.html" copy code={`<p>Interactions that <motion-underline>feel right</motion-underline>.</p>`} />

      <h2>Wave</h2>
      <p>Set <code>shape="wave"</code> for a wavy line. It keeps its text on one line, so use it on a word or a short phrase.</p>
      <DocsPreview replayId="underline-wave">
        <p class="sentence">Springs, not <motion-underline id="underline-wave" shape="wave" style="--mc-mark-color: var(--mc-color-accent)">easing curves</motion-underline>.</p>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={`<motion-underline shape="wave">easing curves</motion-underline>`} />

      <h2>Dashed and dotted</h2>
      <p>Set <code>shape="dashed"</code> or <code>shape="dotted"</code>. Both follow text that wraps, like the straight line.</p>
      <DocsPreview replayId="underline-styles">
        <p class="sentence" id="underline-styles">A <motion-underline shape="dashed">dashed note</motion-underline> and a <motion-underline shape="dotted" delay="0.3" style="--mc-mark-thickness: 3px">dotted term</motion-underline>.</p>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={`<motion-underline shape="dashed">dashed note</motion-underline>
<motion-underline shape="dotted" style="--mc-mark-thickness: 3px">dotted term</motion-underline>`} />

      <h2>Thick and colored</h2>
      <DocsPreview replayId="underline-thick">
        <p class="sentence">Built for <motion-underline id="underline-thick" style="--mc-mark-color: var(--mc-color-accent); --mc-mark-thickness: 4px">every framework</motion-underline>.</p>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={`<motion-underline style="--mc-mark-color: #2563eb; --mc-mark-thickness: 4px">every framework</motion-underline>`} />

      <h2>On hover</h2>
      <p>With <code>trigger="hover"</code> the line draws when the pointer enters and undraws when it leaves, from wherever it is.</p>
      <DocsPreview>
        <p class="sentence"><a class="link" href="#on-hover"><motion-underline trigger="hover">Read the guide</motion-underline></a></p>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={`<a href="/guide/"><motion-underline trigger="hover">Read the guide</motion-underline></a>`} />

      <h2>Properties</h2>
      <PropsTable nameLabel="Attribute" rows={[
        { name: 'trigger', type: 'string', default: "'view'", description: "What draws the mark: <code>'view'</code> when it scrolls into view, <code>'hover'</code> on pointer enter (it undraws on leave), or <code>'mount'</code> when it connects" },
        { name: 'duration', type: 'number', default: '0.6', description: 'Spring duration of the drawing, in seconds' },
        { name: 'delay', type: 'number', default: '0', description: 'Seconds to wait before drawing. Use it to draw several marks in one sentence one after another' },
        { name: 'bounce', type: 'number', default: '0', description: 'Spring bounciness. <code>0</code> keeps the stroke from overshooting the text' },
        { name: 'once', type: 'boolean', default: 'true', description: 'With <code>trigger="view"</code>, draw only the first time. Set <motion-code-inline copy>once="false"</motion-code-inline> to undraw when it leaves and draw again on every entry' },
        { name: 'threshold', type: 'number', default: '0.6', description: 'Share of the element, from 0 to 1, that must be visible before it draws' },
        { name: 'shape', type: 'string', default: "'line'", description: "<code>'line'</code>, <code>'dashed'</code> or <code>'dotted'</code>, which follow wrapping text, or <code>'wave'</code>, a wavy line that keeps the text on one line" },
      ]} />

      <h2>CSS custom properties</h2>
      <PropsTable nameLabel="Property" rows={[
        { name: '--mc-mark-color', type: 'color', default: 'currentColor', description: 'Color of the line' },
        { name: '--mc-mark-thickness', type: 'length', default: '2px', description: 'Thickness of the line' },
      ]} />

      <h2>JavaScript API</h2>
      <p>The mark has the shared playback API: <code>play()</code> draws it, <code>cancel()</code> removes it, <code>finish()</code> shows it fully drawn and <code>replay()</code> draws it again from the start. It fires <code>motion-start</code>, <code>motion-finish</code> and <code>motion-cancel</code>. See the <a href="/docs/js-api/">JavaScript API</a>.</p>

      <h2>Accessibility</h2>
      <p>The mark is decoration: the text stays real, selectable and read by screen readers exactly as written. With <code>trigger="hover"</code> the line follows the pointer only; give links their own focus style. Respects <code>prefers-reduced-motion</code>: the mark appears fully drawn at once, with no animation.</p>
      <DocsPagination />
    </main>
    <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-split";
  import "motion-components/motion-underline";
</script>

<style>
  .sentence {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.5;
    color: var(--mc-color-text);
    text-align: center;
  }
  .link {
    color: inherit;
    text-decoration: none;
  }
</style>
