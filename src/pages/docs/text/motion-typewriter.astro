---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-typewriter — Motion Components" description="Types out its text content character by character when it scrolls into view. Supports looping, a blinking cursor, and configurable timing." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-typewriter</motion-split></h1>
      <p class="lead">
        Types out its text content character by character when it scrolls into view. Supports looping, a blinking cursor, and configurable timing.
      </p>

      <h2>Preview</h2>
      <DocsPreview replayId="tw-demo">
        <motion-typewriter id="tw-demo" interval="0.055" loop cursor class="demo-text"> Motion that feels alive. </motion-typewriter>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-typewriter'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <CodeWindow
        filename="motion-typewriter.html"
        copy
        code={`<motion-typewriter interval="0.05" loop>
  Hello, world.
</motion-typewriter>`}
      />

      <h2>Properties</h2>
      <PropsTable nameLabel="Attribute" rows={[
        { name: 'interval', type: 'number', default: '0.05', description: 'Time between characters while typing, in seconds' },
        { name: 'delay', type: 'number', default: '0', description: 'Delay before typing starts after viewport entry, in seconds' },
        { name: 'hold', type: 'number', default: '1.8', description: 'Time to hold the finished line before erasing, in seconds (loop only)' },
        { name: 'loop', type: 'boolean', default: 'false', description: 'Erase and retype continuously' },
        { name: 'gap', type: 'number', default: '0.5', description: 'With <code>loop</code>, seconds the line stays empty after erasing before typing starts again' },
        { name: 'pause-on-hover', type: 'boolean', default: 'false', description: 'With <code>loop</code>, freeze the cycle while the pointer is over the text, resuming on leave' },
        { name: 'cursor', type: 'boolean', default: 'true', description: 'Show a blinking cursor. Set <motion-code-inline copy>cursor="false"</motion-code-inline> to hide it' },
      ]} />
      <h2>Pause on hover</h2>
      <p>
        Add <code>pause-on-hover</code> to freeze the typing cycle while the pointer is over the text. <code>gap</code>
        sets the empty pause between erasing and retyping.
      </p>
      <DocsPreview replayId="typewriter-loop">
        <p class="sentence">
          <motion-typewriter
            id="typewriter-loop"
            interval="0.06"
            loop
            hold="1.2"
            gap="0.8"
            pause-on-hover>Hover to hold the line</motion-typewriter
          >
        </p>
      </DocsPreview>
      <CodeWindow
        filename="motion-typewriter-loop.html"
        copy
        code={`<motion-typewriter interval="0.06" loop hold="1.2" gap="0.8" pause-on-hover>
  Hover to hold the line
</motion-typewriter>`}
      />

      <h2>JavaScript API</h2>
      <p class="section-desc">Control the typewriter programmatically with <code>play()</code>, <code>pause()</code>, <code>finish()</code>, and <code>cancel()</code>.</p>
      <JsApiDemo mode="looper" target="api-typewriter-demo" wide>
        <motion-typewriter id="api-typewriter-demo" loop>
          JavaScript API demo
        </motion-typewriter>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>Respects <code>prefers-reduced-motion</code>: when enabled, the typing animation is skipped, the full text appears immediately and <code>loop</code> never starts.</p>
      <DocsPagination />
    </main>
      <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-split";
  import "motion-components/motion-typewriter";
</script>

<style>
  .demo-text {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--mc-color-text);
  }
</style>
