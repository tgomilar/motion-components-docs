---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import DocsTable from "../../../components/DocsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-counter — Motion Components" description="Animates a number from one value to another using spring physics when it enters the viewport. Great for stats, scores, and dashboards." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-counter</motion-split></h1>
      <p class="lead">Animates a number from one value to another using spring physics when it enters the viewport. Great for stats, scores, and dashboards.</p>

      <h2>Preview</h2>
      <DocsPreview replayId="counter-stats">
        <div class="stats-grid" id="counter-stats">
          <div class="stat">
            <motion-counter class="stat-num" from="0" to="9847" duration="1.8" suffix="+"></motion-counter>
            <span class="stat-label">Active users</span>
          </div>
          <div class="stat">
            <motion-counter class="stat-num" from="0" to="2.4" duration="2" decimals="1" prefix="$" suffix="M"></motion-counter>
            <span class="stat-label">Revenue</span>
          </div>
          <div class="stat">
            <motion-counter class="stat-num accent" from="0" to="98" duration="1.5" suffix="%"></motion-counter>
            <span class="stat-label">Satisfaction</span>
          </div>
        </div>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-counter'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <CodeWindow
        filename="motion-counter.html"
        copy
        code={`<motion-counter from="0" to="9847" duration="1.8" suffix="+"></motion-counter>`}
      />

      <h2>How it works</h2>
      <p>The counter watches the viewport via <code>IntersectionObserver</code>. When 20% of the element is visible, it animates the number from <code>from</code> to <code>to</code> using a spring. By default (<code>once</code>), it only fires once and disconnects the observer.</p>

      <h2>Prefix &amp; suffix</h2>
      <p>Attach static text before or after the number. This is useful for currency symbols, units, and percentages.</p>
      <CodeWindow
        filename="motion-counter.html"
        copy
        code={`<!-- Currency -->
<motion-counter from="0" to="2.4" decimals="1" prefix="$" suffix="M"></motion-counter>

<!-- Percentage -->
<motion-counter from="0" to="98" suffix="%"></motion-counter>

<!-- Score -->
<motion-counter from="0" to="9847" suffix="+"></motion-counter>`}
      />

      <h2>Decimals</h2>
      <p>Control how many decimal places are displayed. The spring animates through fractional values so the decimal digits flow naturally.</p>
      <CodeWindow
        filename="motion-counter.html"
        copy
        code={`<motion-counter from="0" to="4.87" decimals="2" suffix=" GB"></motion-counter>`}
      />

      <h2>Repeat on re-entry</h2>
      <p>
        <code>once</code> defaults to <code>true</code>. Set <motion-code-inline copy>once="false"</motion-code-inline> to count again every
        time the element re-enters the viewport. From JavaScript, set the <code>once</code> property to <code>false</code>.
      </p>
      <CodeWindow
        filename="motion-counter.html"
        copy
        code={`<motion-counter from="0" to="100" once="false"></motion-counter>`}
      />

      <h2>Loop</h2>
      <p>
        Add <code>loop</code> to count to <code>to</code>, hold, snap back to <code>from</code> and count again, like a
        dashboard that keeps ticking. <code>hold</code> sets how long the final number stays, <code>gap</code> how long it
        sits back at the start.
      </p>
      <DocsPreview replayId="counter-loop">
        <p class="sentence">
          Requests per second: <motion-counter
            id="counter-loop"
            from="120"
            to="480"
            duration="1.2"
            loop
            hold="1.2"
            gap="0.4"
          ></motion-counter>
        </p>
      </DocsPreview>
      <CodeWindow
        filename="motion-counter.html"
        copy
        code={`<motion-counter from="120" to="480" loop hold="1.2" gap="0.4"></motion-counter>`}
      />
      <p>
        With <code>loop</code> the cycle runs only while the counter is on screen, and <code>once</code> is ignored. Add
        <code>pause-on-hover</code> to freeze the cycle while the pointer is over it.
      </p>

      <h2>Methods</h2>
      <DocsTable
        columns={[{ label: "Method" }, { label: "Description" }]}
        rows={[[
          { code: "replay()" },
          { html: "Restart the animation from <code>from</code> immediately, regardless of viewport state." },
        ]]}
        copy
      />
      <CodeWindow
        filename="app.js"
        copy
        code={`const counter = document.querySelector('motion-counter')
counter.replay()`}
      />

      <h2>Properties</h2>
      <PropsTable nameLabel="Attribute" rows={[
        { name: 'from', type: 'number', default: '0', description: 'Starting value' },
        { name: 'to', type: 'number', default: '100', description: 'End value' },
        { name: 'duration', type: 'number', default: '1.5', description: 'Spring duration hint in seconds' },
        { name: 'decimals', type: 'number', default: '0', description: 'Number of decimal places to display' },
        { name: 'prefix', type: 'string', default: "''", description: 'Static text prepended to the number' },
        { name: 'suffix', type: 'string', default: "''", description: 'Static text appended to the number' },
        { name: 'once', type: 'boolean', default: 'true', description: 'Animate only on first intersection. Set to <code>false</code> to replay on every re-entry. Ignored with <code>loop</code>' },
        { name: 'loop', type: 'boolean', default: 'false', description: 'Count to <code>to</code>, hold, snap back to <code>from</code> and count again on repeat. The cycle runs while the counter is on screen' },
        { name: 'hold', type: 'number', default: '1.6', description: 'With <code>loop</code>, seconds the counter stays at <code>to</code> before snapping back' },
        { name: 'gap', type: 'number', default: '0.5', description: 'With <code>loop</code>, seconds the counter stays at <code>from</code> before counting again' },
        { name: 'pause-on-hover', type: 'boolean', default: 'false', description: 'Pause the loop while the pointer is over the counter, resuming on leave' },
      ]} />

      <h2>JavaScript API</h2>
      <p class="section-desc">Trigger the counter programmatically with <code>play()</code> and <code>cancel()</code>.</p>
      <JsApiDemo target="api-counter-demo" mode="one-shot" wide>
        <motion-counter id="api-counter-demo" to="12345" duration="2"></motion-counter>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>
        When <code>prefers-reduced-motion</code> is set, the counter jumps instantly to its final value with no animation,
        and <code>loop</code> never starts.
      </p>
      <DocsPagination />
    </main>
      <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-counter";
  import "motion-components/motion-split";

  // Replay button replays all counters in the stats grid
  document.querySelector('[data-replay="counter-stats"]')?.addEventListener('click', () => {
    document.querySelectorAll<any>('#counter-stats motion-counter').forEach(el => el.replay())
  })
</script>

<style>
  /* ── Stats preview ── */
  .stats-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 3rem;
    align-items: flex-start;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .stat-num {
    font-size: clamp(2.25rem, 10vw, 3rem);
    white-space: nowrap;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--mc-color-text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-num.accent {
    color: var(--mc-color-accent);
  }

  .stat > div {
    display: flex;
    align-items: baseline;
  }

  .stat-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--mc-color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
