---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-liquid — Motion Components" description="Applies an animated SVG displacement filter to text, giving it a living, fluid quality. It feels like ink in water or hot air shimmer. No WebGL required." noMain>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-liquid</motion-split></h1>
      <p class="lead">Applies an animated SVG displacement filter to text, giving it a living, fluid quality. It feels like ink in water or hot air shimmer. No WebGL required.</p>

      <h2>Preview</h2>
      <DocsPreview>
        <motion-liquid class="demo-large" intensity="12" duration="6">LIQUID</motion-liquid>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-liquid'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <h3>Static content</h3>
      <p>Write the text as a child. The browser shows it as plain text before the element is defined, so the page never paints an empty gap while the library loads.</p>
      <CodeWindow
        filename="motion-liquid.html"
        copy
        code={`<motion-liquid intensity="12" duration="4.5">LIQUID</motion-liquid>`}
      />

      <h3>Dynamic content</h3>
      <p>Use the <code>text</code> attribute when text changes at runtime. Setting the property restarts the animation automatically.</p>
      <CodeWindow
        filename="app.ts"
        copy
        code={`const el = document.querySelector('motion-liquid')
el.text = 'UPDATED'   // animation restarts`}
      />
      <p>
        If both are present, the attribute wins and the child text stays as the pre-upgrade fallback.
      </p>

      <h2>Intensity</h2>
      <p><motion-code-inline>intensity</motion-code-inline> sets the maximum displacement in pixels. Higher values create more dramatic distortion.</p>
      <DocsPreview>
        <div style="display:flex; flex-direction:column; gap:1.5rem; align-items:flex-start">
          <motion-liquid class="demo-large" intensity="5" duration="6">SUBTLE</motion-liquid>
          <motion-liquid class="demo-large" intensity="24" duration="6">INTENSE</motion-liquid>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-liquid.html"
        copy
        code={`<motion-liquid intensity="5">SUBTLE</motion-liquid>
<motion-liquid intensity="24">INTENSE</motion-liquid>`}
      />

      <h2>Duration</h2>
      <p><motion-code-inline>duration</motion-code-inline> sets the seconds per distortion cycle. Long cycles feel like a gentle shimmer. Short cycles feel chaotic. Set it to <motion-code-inline>0</motion-code-inline> to hold the text still.</p>
      <DocsPreview>
        <div style="display:flex; flex-direction:column; gap:1.5rem; align-items:flex-start">
          <motion-liquid class="demo-large" intensity="14" duration="18">SLOW</motion-liquid>
          <motion-liquid class="demo-large" intensity="14" duration="2.25">FAST</motion-liquid>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-liquid.html"
        copy
        code={`<motion-liquid intensity="14" duration="18">SLOW</motion-liquid>
<motion-liquid intensity="14" duration="2.25">FAST</motion-liquid>`}
      />

      <h2>Pause on hover</h2>
      <p>Add <motion-code-inline>pause-on-hover</motion-code-inline> to freeze the fluid motion when the cursor enters.</p>
      <DocsPreview>
        <motion-liquid class="demo-large" intensity="14" duration="6" pause-on-hover>HOVER ME</motion-liquid>
      </DocsPreview>
      <CodeWindow
        filename="motion-liquid.html"
        copy
        code={`<motion-liquid intensity="14" duration="6" pause-on-hover>
  HOVER ME
</motion-liquid>`}
      />

      <h2>How it works</h2>
      <p>
        An SVG <motion-code-inline>&lt;filter&gt;</motion-code-inline> with <motion-code-inline>&lt;feTurbulence&gt;</motion-code-inline> and <motion-code-inline>&lt;feDisplacementMap&gt;</motion-code-inline> is applied to an SVG <motion-code-inline>&lt;text&gt;</motion-code-inline> element, and SMIL <motion-code-inline>&lt;animate&gt;</motion-code-inline> elements drive its <motion-code-inline>baseFrequency</motion-code-inline> and <motion-code-inline>scale</motion-code-inline> over time. Filtering SVG content (rather than an HTML element via CSS <motion-code-inline>filter: url()</motion-code-inline>) is what keeps it animating on WebKit/iOS, where a <motion-code-inline>url()</motion-code-inline> filter on HTML only repaints on scroll.
      </p>

      <h2>Properties</h2>
      <PropsTable nameLabel="Attribute" rows={[
        { name: 'text', type: 'string', default: '—', description: 'Text to render with the liquid effect. Falls back to the child text when unset' },
        { name: 'intensity', type: 'number', default: '10', description: 'Maximum displacement in px' },
        { name: 'duration', type: 'number', default: '4.5', description: 'Seconds per distortion cycle. Lower is faster, <code>0</code> holds the text still' },
        { name: 'pause-on-hover', type: 'boolean', default: 'false', description: 'Freeze motion on mouseenter, resume on mouseleave' },
      ]} />

      <h2>JavaScript API</h2>
      <p class="section-desc">Control the liquid programmatically with <code>play()</code>, <code>pause()</code>, <code>finish()</code>, and <code>cancel()</code>.</p>
      <JsApiDemo target="api-liquid-demo" wide>
        <motion-liquid id="api-liquid-demo" text="JS API · demo · " duration="3">
        </motion-liquid>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>When <motion-code-inline>prefers-reduced-motion</motion-code-inline> is set, the animation loop does not start and the text renders without distortion.</p>
      <DocsPagination />
    </main>
      <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-liquid";
  import "motion-components/motion-split";
</script>

<style>
  .demo-large {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
</style>
