---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import PropsTable from "../../../components/PropsTable.astro";
import JsApiDemo from "../../../components/JsApiDemo.astro";
import "../../../styles/docs.css";
---

<Layout title="motion-gravity — Motion Components" description="Characters fall in from above with staggered spring-physics timing. Each one bounces to a rest at the baseline. Built for hero text and section titles." noMain>
  <div class="layout">
    <DocsSidebar />

    <main>
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-gravity</motion-split></h1>
      <p class="lead">
        Characters fall in from above with staggered spring-physics timing. Each one bounces to a rest at the baseline. An entrance animation built for hero
        text and section titles.
      </p>

      <h2>Preview</h2>
      <DocsPreview replayId="gravity-demo">
        <motion-gravity id="gravity-demo" class="demo-large">GRAVITY</motion-gravity>
      </DocsPreview>

      <h2>Import</h2>
      <CodeWindow
        filename="app.ts"
        copy
        code={`import 'motion-components/motion-gravity'   // just this one
import 'motion-components'               // or the whole library`}
      />

      <h2>Usage</h2>
      <h3>Static content</h3>
      <p>Write the text as a child. The browser shows it as plain text before the element is defined, so the page never paints an empty gap while the library loads.</p>
      <CodeWindow filename="motion-gravity.html" copy code={`<motion-gravity>GRAVITY</motion-gravity>`} />

      <h3>Dynamic content</h3>
      <p>Use the <code>text</code> attribute when text changes at runtime. Setting the property restarts the animation automatically.</p>
      <CodeWindow
        filename="app.ts"
        copy
        code={`const el = document.querySelector('motion-gravity')
el.text = 'UPDATED'   // animation restarts`}
      />
      <p>
        If both are present, the attribute wins and the child text stays as the pre-upgrade fallback.
      </p>

      <h2>Height</h2>
      <p><code>height</code> sets how far each character falls before landing. Larger values give a more dramatic entrance.</p>
      <DocsPreview replayId="gravity-height">
        <div id="gravity-height" style="display:flex; flex-direction:column; gap:2rem; align-items:flex-start">
          <motion-gravity class="demo-large" height="20">SHORT DROP</motion-gravity>
          <motion-gravity class="demo-large" height="120">LONG DROP</motion-gravity>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-gravity.html"
        copy
        code={`<motion-gravity height="20">SHORT DROP</motion-gravity>
<motion-gravity height="120">LONG DROP</motion-gravity>`}
      />

      <h2>Interval</h2>
      <p><code>interval</code> is the delay in seconds between each character landing. Use a small value for a fast cascade and a larger one for a slow reveal.</p>
      <DocsPreview replayId="gravity-stagger">
        <div id="gravity-stagger" style="display:flex; flex-direction:column; gap:2rem; align-items:flex-start">
          <motion-gravity class="demo-large" interval="0.02">FAST CASCADE</motion-gravity>
          <motion-gravity class="demo-large" interval="0.15">SLOW REVEAL</motion-gravity>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-gravity.html"
        copy
        code={`<motion-gravity interval="0.02">FAST CASCADE</motion-gravity>
<motion-gravity interval="0.15">SLOW REVEAL</motion-gravity>`}
      />

      <h2>Delay</h2>
      <p>Use <code>delay</code> to hold the animation until after other elements have entered. This is useful when composing multiple animated elements.</p>
      <DocsPreview replayId="gravity-delay">
        <div id="gravity-delay" style="display:flex; flex-direction:column; gap:2rem; align-items:flex-start">
          <motion-gravity class="demo-large" delay="0">FIRST</motion-gravity>
          <motion-gravity class="demo-large" delay="0.5">SECOND</motion-gravity>
        </div>
      </DocsPreview>
      <CodeWindow
        filename="motion-gravity.html"
        copy
        code={`<motion-gravity delay="0">FIRST</motion-gravity>
<motion-gravity delay="0.5">SECOND</motion-gravity>`}
      />

      <h2>How it works</h2>
      <p>
        Each character is wrapped in an inline-block <code>span</code>. On first render (and whenever <code>text</code> changes), all characters are set to <code
          >opacity: 0</code
        > and <code>translateY(-height)</code>. Motion then springs them back to their natural position, tuned with <code>duration</code> and <code>bounce</code>. Each character starts <code>interval</code> seconds after the previous one, after an optional <code>delay</code>.
      </p>

      <h2>Properties</h2>
      <PropsTable
        nameLabel="Attribute"
        rows={[
          { name: "text", type: "string", default: "—", description: "Text to animate in. Falls back to the child text when unset" },
          { name: "height", type: "number", default: "60", description: "Fall distance in px" },
          { name: "interval", type: "number", default: "0.05", description: "Seconds between each character landing" },
          { name: "duration", type: "number", default: "0.6", description: "Spring duration of each character's fall, in seconds" },
          { name: "bounce", type: "number", default: "0.45", description: "Spring bounciness of the landing (0 = no overshoot)" },
          { name: "delay", type: "number", default: "0", description: "Seconds to wait before the first character falls" },
        ]}
      />

      <h2>JavaScript API</h2>
      <p class="section-desc">Trigger the gravity programmatically with <code>play()</code> and <code>cancel()</code>.</p>
      <JsApiDemo target="api-gravity-demo" mode="one-shot" wide>
        <motion-gravity id="api-gravity-demo" text="JavaScript API" duration="0.4">
        </motion-gravity>
      </JsApiDemo>

      <h2>Accessibility</h2>
      <p>Screen readers read the whole text once from a visually hidden copy. The animated letters are hidden from them. When <code>prefers-reduced-motion</code> is set, characters render immediately in their final position with no animation.</p>
      <DocsPagination />
    </main>
    <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components";

  ["gravity-height", "gravity-stagger", "gravity-delay"].forEach((id) => {
    const el = document.getElementById(id);
    if (el) (el as any).replay = () => el.querySelectorAll("motion-gravity").forEach((c: any) => c.replay());
  });
</script>

<style>
  .demo-large {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

</style>
