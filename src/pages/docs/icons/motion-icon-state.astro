---
import Layout from "../../../layouts/Layout.astro";
import DocsPreview from "../../../components/DocsPreview.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsTOC from "../../../components/DocsTOC.astro";
import DocsPagination from "../../../components/DocsPagination.astro";
import CodeWindow from "../../../components/CodeWindow.astro";
import FwTabs from "../../../components/FwTabs.astro";
import PropsTable from "../../../components/PropsTable.astro";
import DocsTable from "../../../components/DocsTable.astro";
import "../../../styles/docs.css";

const CDN = "https://cdn.jsdelivr.net/npm/motion-components@1/dist";

const icons = [
  { name: "menu", label: "Menu", off: "menu", on: "close" },
  { name: "play", label: "Play", off: "play", on: "pause" },
  { name: "copy", label: "Copy", off: "copy", on: "check" },
  { name: "plus", label: "Expand", off: "plus", on: "minus" },
  { name: "chevron", label: "Expand", off: "chevron down", on: "chevron up" },
  { name: "heart", label: "Like", off: "empty heart", on: "filled heart" },
  { name: "loading", label: "Saving", off: "spinner", on: "check" },
  { name: "eye", label: "Show password", off: "eye", on: "eye-off" },
];

const allIcons = icons.map((i) => `<motion-icon-state name="${i.name}" toggle label="${i.label}"></motion-icon-state>`).join("\n");

const quickStart = `<!doctype html>
<html>
  <head>
    <script type="module" src="${CDN}/motion-icon-state.js/+esm"></script>
  </head>
  <body>
    <motion-icon-state name="heart" toggle label="Like"></motion-icon-state>
  </body>
</html>`;

const recipes = {
  menu: `<button id="menu-button" aria-label="Menu" aria-expanded="false">
  <motion-icon-state name="menu"></motion-icon-state>
</button>

<script type="module">
  const button = document.querySelector('#menu-button')

  button.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true'
    button.setAttribute('aria-expanded', open)
    button.querySelector('motion-icon-state').active = open
  })
</script>`,
  copy: `<button id="copy-button">
  <motion-icon-state name="copy"></motion-icon-state>
  Copy
</button>

<script type="module">
  const button = document.querySelector('#copy-button')
  const icon = button.querySelector('motion-icon-state')

  button.addEventListener('click', async () => {
    await navigator.clipboard.writeText('Text to copy')
    icon.active = true
    setTimeout(() => (icon.active = false), 1500)
  })
</script>`,
  save: `<button id="save-button">
  <motion-icon-state name="loading" active></motion-icon-state>
  Save
</button>

<script type="module">
  const button = document.querySelector('#save-button')
  const icon = button.querySelector('motion-icon-state')

  button.addEventListener('click', async () => {
    icon.active = false   // spinner
    await new Promise((resolve) => setTimeout(resolve, 1500))   // replace with your save
    icon.active = true    // check
  })
</script>`,
  password: `<input id="password" type="password" value="secret" />
<button id="password-button" aria-label="Show password">
  <motion-icon-state name="eye"></motion-icon-state>
</button>

<script type="module">
  const input = document.querySelector('#password')
  const button = document.querySelector('#password-button')

  button.addEventListener('click', () => {
    const visible = input.type === 'password'
    input.type = visible ? 'text' : 'password'
    button.setAttribute('aria-label', visible ? 'Hide password' : 'Show password')
    button.querySelector('motion-icon-state').active = visible
  })
</script>`,
  details: `<details id="faq">
  <summary>
    What is motion-components?
    <motion-icon-state name="chevron"></motion-icon-state>
  </summary>
  Web components with spring-based motion.
</details>

<script type="module">
  const details = document.querySelector('#faq')

  details.addEventListener('toggle', () => {
    details.querySelector('motion-icon-state').active = details.open
  })
</script>`,
  like: `<motion-icon-state id="like" name="heart" toggle label="Like"></motion-icon-state>

<script type="module">
  document.querySelector('#like').addEventListener('motion-change', (event) => {
    console.log(event.detail.active ? 'liked' : 'unliked')
  })
</script>`,
};

const frameworkTabs = [
  {
    id: "vanilla",
    label: "HTML / Astro / Svelte",
    desc: "Set the <code>active</code> attribute, or the <code>active</code> property from a script.",
    filename: "index.html",
    code: `<script type="module" src="${CDN}/motion-icon-state.js/+esm"></script>

<motion-icon-state name="heart" toggle label="Like"></motion-icon-state>`,
  },
  {
    id: "react",
    label: "React",
    desc: "React 19 sets <code>active</code> as a property, so pass a boolean from state.",
    filename: "LikeButton.jsx",
    code: `import { useState } from 'react'
import 'motion-components/motion-icon-state'

export function LikeButton() {
  const [liked, setLiked] = useState(false)

  return (
    <button aria-pressed={liked} onClick={() => setLiked(!liked)}>
      <motion-icon-state name="heart" active={liked}></motion-icon-state>
      Like
    </button>
  )
}`,
  },
  {
    id: "vue",
    label: "Vue 3",
    desc: "Tell Vue that <code>motion-*</code> tags are custom elements (see <a href=\"/docs/#frameworks\">Getting started</a>), then bind <code>:active</code>.",
    filename: "LikeButton.vue",
    code: `<script setup>
import { ref } from 'vue'
import 'motion-components/motion-icon-state'

const liked = ref(false)
</script>

<template>
  <button :aria-pressed="liked" @click="liked = !liked">
    <motion-icon-state name="heart" :active="liked"></motion-icon-state>
    Like
  </button>
</template>`,
  },
];
---

<Layout
  title="motion-icon-state — Motion Components"
  description="Icons that morph between two states on a spring: menu and close, play and pause, copy and check, plus and minus, chevron, heart, loading and done, eye and eye-off."
  noMain
>
  <div class="layout">
    <DocsSidebar />

    <main id="main">
      <h1><motion-split by="chars" interval="0.025" duration="0.5">motion-icon-state</motion-split></h1>
      <p class="lead">
        Icons that morph between two states on a spring, and can be interrupted midway. Set <code>name</code> to pick the icon and <code>active</code> for
        the second state. They are drawn on a 24&nbsp;px grid with 2&nbsp;px round strokes, so they sit next to Lucide, Tabler and Heroicons icons.
      </p>
      <p class="note">
        This component used to be called <code>motion-state-icon</code>. The old tag and the
        <code>motion-components/motion-state-icon</code> import still work, with a warning in the console, until version 2.0.
      </p>

      <h2>Preview</h2>
      <p>Click an icon to switch its state.</p>
      <DocsPreview compact>
        <div class="grid">
          {icons.map((i) => (
            <div class="cell">
              <motion-icon-state name={i.name} toggle label={i.label}></motion-icon-state>
              <span>{i.name}</span>
            </div>
          ))}
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={allIcons} />

      <h2>Quick start</h2>
      <p>Save this as <code>index.html</code> and open it in a browser. No install, no build step.</p>
      <CodeWindow filename="index.html" copy code={quickStart} />
      <p>In a project with a bundler, install the package and import the component once:</p>
      <CodeWindow filename="terminal" copy code={`npm install motion-components`} />
      <CodeWindow filename="app.js" copy code={`import 'motion-components/motion-icon-state'`} />

      <h2>Icons</h2>
      <p>Without <code>active</code>, the icon shows its first state. With <code>active</code>, it shows the second.</p>
      <DocsTable
        columns={[
          { label: "name", code: true },
          { label: "Default" },
          { label: "active", code: true },
        ]}
        rows={icons.map((i) => [{ code: i.name }, i.off, i.on])}
      />

      <h2>Two ways to switch</h2>
      <h3>1. The icon is the button</h3>
      <p>
        Add <code>toggle</code> and <code>label</code>. The icon switches itself on click, <kbd>Space</kbd> or <kbd>Enter</kbd>, and fires
        <code>motion-change</code>. <code>label</code> is required here: it is the button's name for screen readers, and leaving it out logs a warning.
      </p>
      <DocsPreview compact>
        <div class="grid">
          <div class="cell"><motion-icon-state id="like" name="heart" toggle label="Like"></motion-icon-state><span id="like-state">not liked</span></div>
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={recipes.like} />

      <h3>2. Your button controls the icon</h3>
      <p>
        Leave out <code>toggle</code> and set <code>active</code> from your own code. Use this when the icon sits inside a button or link that already
        handles the click and has the accessible name. All the recipes below work this way.
      </p>

      <h2>Recipes</h2>
      <p>Each snippet is complete. Paste it into a page that loads the library.</p>

      <h3>Menu button</h3>
      <DocsPreview compact>
        <div class="grid">
          <button class="demo-action icon-only" id="menu-button" type="button" aria-label="Menu" aria-expanded="false"><motion-icon-state name="menu"></motion-icon-state></button>
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={recipes.menu} />

      <h3>Copy button</h3>
      <DocsPreview compact>
        <div class="grid">
          <button class="demo-action" id="copy-button" type="button"><motion-icon-state name="copy"></motion-icon-state>Copy</button>
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={recipes.copy} />

      <h3>Save button</h3>
      <DocsPreview compact>
        <div class="grid">
          <button class="demo-action" id="save-button" type="button"><motion-icon-state name="loading" active></motion-icon-state>Save</button>
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={recipes.save} />

      <h3>Show password</h3>
      <DocsPreview compact>
        <div class="grid">
          <div class="password">
            <input id="password" type="password" value="secret" aria-label="Password" />
            <button class="demo-action icon-only" id="password-button" type="button" aria-label="Show password"><motion-icon-state name="eye"></motion-icon-state></button>
          </div>
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={recipes.password} />

      <h3>Accordion</h3>
      <DocsPreview compact>
        <details id="faq" class="faq">
          <summary>What is motion-components?<motion-icon-state name="chevron"></motion-icon-state></summary>
          <p>Web components with spring-based motion.</p>
        </details>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={recipes.details} />

      <p class="note">More patterns, such as a like button with a count and a download button, are on the <a href="/docs/recipes/icons/">Icon Recipes</a> page.</p>

      <h2>Frameworks</h2>
      <FwTabs tabs={frameworkTabs} group="frameworks" />

      <h2>Colors</h2>
      <p>
        Lines use <code>--mc-icon-color</code>, which defaults to the text color. <code>--mc-icon-color-active</code> colors the icon in its second
        state, such as the close cross of <code>menu</code>, the filled heart or the copy check. It defaults to the line color, so set it when the second
        state should stand out.
      </p>
      <DocsPreview compact>
        <div class="grid">
          <div class="cell"><motion-icon-state name="heart" toggle label="Like" active></motion-icon-state><span>default</span></div>
          <div class="cell"><motion-icon-state name="heart" toggle label="Like" active style="--mc-icon-color-active: #f59e0b"></motion-icon-state><span>--mc-icon-color-active</span></div>
          <div class="cell"><motion-icon-state name="copy" toggle label="Copy" active style="--mc-icon-color: #6366f1"></motion-icon-state><span>--mc-icon-color</span></div>
          <div class="cell"><motion-icon-state name="eye" toggle label="Show" style="--mc-icon-color: #0ea5e9; --mc-icon-size: 2rem"></motion-icon-state><span>--mc-icon-size</span></div>
          <div class="cell"><motion-icon-state name="menu" toggle label="Menu" active style="--mc-icon-color-active: #e11d48"></motion-icon-state><span>--mc-icon-color-active</span></div>
        </div>
      </DocsPreview>
      <CodeWindow filename="index.html" copy code={`<motion-icon-state name="heart" active style="--mc-icon-color-active: #f59e0b"></motion-icon-state>
<motion-icon-state name="copy" active style="--mc-icon-color: #6366f1"></motion-icon-state>
<motion-icon-state name="eye" style="--mc-icon-color: #0ea5e9; --mc-icon-size: 2rem"></motion-icon-state>
<motion-icon-state name="menu" active style="--mc-icon-color-active: #e11d48"></motion-icon-state>`} />

      <h2>Properties</h2>
      <PropsTable
        nameLabel="Attribute"
        rows={[
          { name: "name", type: "string", default: "'menu'", description: "<code>'menu'</code>, <code>'play'</code>, <code>'copy'</code>, <code>'plus'</code>, <code>'chevron'</code>, <code>'heart'</code>, <code>'loading'</code> or <code>'eye'</code>" },
          { name: "active", type: "boolean", default: "false", description: "The second state: close, pause, check, minus, up, filled, done or eye-off" },
          { name: "toggle", type: "boolean", default: "false", description: "Makes the icon a button that switches <code>active</code> on click, Space or Enter" },
          { name: "label", type: "string", default: "''", description: "Accessible name. Required with <code>toggle</code>: without it the icon name is read out and a warning is logged. Without <code>label</code> and <code>toggle</code>, the icon is decorative" },
          { name: "duration", type: "number", default: "0.45", description: "Spring duration of the morph, in seconds" },
          { name: "bounce", type: "number", default: "0.3", description: "Spring bounciness of the morph" },
        ]}
      />

      <h2>CSS custom properties</h2>
      <PropsTable
        nameLabel="Property"
        rows={[
          { name: "--mc-icon-color", type: "color", default: "currentColor", description: "Line color" },
          { name: "--mc-icon-color-active", type: "color", default: "--mc-icon-color", description: "Color of the icon in its second state, when <code>active</code> is set, including the filled heart and the copy and loading checks" },
          { name: "--mc-icon-size", type: "length", default: "1.5em", description: "Width and height of the icon" },
        ]}
      />

      <h2>Events</h2>
      <DocsTable
        columns={[
          { label: "Event" },
          { label: "Detail" },
          { label: "Description" },
        ]}
        rows={[[
          { code: "motion-change" },
          { code: "{ active }" },
          { html: "Fired when <code>toggle</code> is set and the user switches the state." },
        ]]}
        copy
      />

      <h2>Accessibility</h2>
      <p>
        With <code>toggle</code>, the icon is a button with <code>aria-pressed</code>, reachable with <kbd>Tab</kbd> and switched with <kbd>Space</kbd> or
        <kbd>Enter</kbd>. Give it a <code>label</code>. Inside your own button, put the name on the button (its text or <code>aria-label</code>) and
        leave the icon without <code>label</code>. With <code>prefers-reduced-motion</code>, the icon switches state at once and the loading spinner
        stands still.
      </p>

      <DocsPagination />
    </main>
    <DocsTOC />
  </div>
</Layout>

<script>
  import "motion-components/motion-split";
  import "motion-components/motion-icon-state";

  type StateIcon = HTMLElement & { active: boolean };
  const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector);
  const iconIn = (el: Element | null) => el?.querySelector<StateIcon>("motion-icon-state");

  $("#like")?.addEventListener("motion-change", (event) => {
    const state = $("#like-state");
    if (state) state.textContent = (event as CustomEvent<{ active: boolean }>).detail.active ? "liked" : "not liked";
  });

  const menu = $("#menu-button");
  menu?.addEventListener("click", () => {
    const open = menu.getAttribute("aria-expanded") !== "true";
    menu.setAttribute("aria-expanded", String(open));
    iconIn(menu)!.active = open;
  });

  const copy = $("#copy-button");
  copy?.addEventListener("click", async () => {
    await navigator.clipboard?.writeText("Text to copy").catch(() => {});
    iconIn(copy)!.active = true;
    setTimeout(() => (iconIn(copy)!.active = false), 1500);
  });

  const save = $("#save-button");
  save?.addEventListener("click", () => {
    iconIn(save)!.active = false;
    setTimeout(() => (iconIn(save)!.active = true), 1500);
  });

  const input = $<HTMLInputElement>("#password");
  const reveal = $("#password-button");
  reveal?.addEventListener("click", () => {
    if (!input) return;
    const visible = input.type === "password";
    input.type = visible ? "text" : "password";
    reveal.setAttribute("aria-label", visible ? "Hide password" : "Show password");
    iconIn(reveal)!.active = visible;
  });

  const faq = $<HTMLDetailsElement>("#faq");
  faq?.addEventListener("toggle", () => (iconIn(faq)!.active = faq.open));
</script>

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.75rem 2.25rem;
    color: var(--mc-color-text);
  }

  .cell {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    --mc-icon-size: 2rem;
  }

  .cell span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mc-color-muted);
  }

  .demo-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--mc-color-border);
    border-radius: 8px;
    background: var(--mc-color-surface);
    color: var(--mc-color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    --mc-icon-size: 1.15rem;
  }

  .demo-action.icon-only {
    padding: 0.6rem;
  }

  .password {
    display: flex;
    gap: 0.5rem;
  }

  .password input {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--mc-color-border);
    border-radius: 8px;
    background: var(--mc-color-surface);
    color: var(--mc-color-text);
    font: inherit;
  }

  .faq {
    max-width: 28rem;
    margin: 0 auto;
    color: var(--mc-color-text);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq p {
    margin: 0.75rem 0 0;
    color: var(--mc-color-muted);
  }
</style>
