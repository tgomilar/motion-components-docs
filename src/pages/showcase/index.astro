---
import Layout from "../../layouts/Layout.astro";
import ShowcaseFonts from "../../components/showcase/ShowcaseFonts.astro";
import UnderlineHover from "../../components/showcase/UnderlineHover.astro";
import { categories, categoryHref } from "../../data/showcase";
import ShowcaseCode from "../../components/showcase/ShowcaseCode.astro";
import "../../styles/showcase.css";

const allTags = categories.flatMap((c) => c.tags.map((t) => `motion-${t}`));
const byslug = Object.fromEntries(categories.map((c) => [c.slug, c]));

const lucide = (name: string) => `https://cdn.jsdelivr.net/npm/lucide-static@1/icons/${name}.svg`;
const icons = [
  ["heart", "draw pulse"],
  ["bell", "draw wiggle"],
  ["rocket", "draw bounce"],
  ["star", "draw pop"],
  ["sun", "draw rotate"],
  ["mail", "draw"],
  ["zap", "draw wiggle"],
  ["music", "draw slide-up"],
];

const code = `<motion-code filename="index.html" typing typing-speed="45"><script type="text/plain"><motion-tilt max="12" gloss>
  <img src="cover.jpg" alt="Album cover" />
</motion-tilt>

<motion-counter to="9847" suffix="+"></motion-counter><\/script></motion-code>`;

const snippets: Record<string, { tags: string[]; code: string }> = {
  text: {
    tags: ["motion-curve", "motion-glitch", "motion-perspective", "motion-liquid"],
    code: `<motion-curve amplitude="22" wave-length="360" wave-duration="2.6">curve</motion-curve>
<motion-glitch trigger="loop" intensity="7">glitch</motion-glitch>
<motion-perspective depth="0.7" vanish="right" loop>perspective</motion-perspective>
<motion-liquid intensity="12" duration="6">liquid</motion-liquid>`,
  },
  reveal: {
    tags: ["motion-blur-in"],
    code: `<motion-blur-in intensity="14" y="18" once="false"><p>Words that wait</p></motion-blur-in>
<motion-blur-in intensity="14" y="18" duration="0.8" once="false"><p>until you reach them,</p></motion-blur-in>
<motion-blur-in intensity="14" y="18" duration="0.9" once="false"><p>then come into focus</p></motion-blur-in>
<motion-blur-in intensity="14" y="18" duration="1" once="false"><p>one line at a time.</p></motion-blur-in>`,
  },
  respond: {
    tags: ["motion-magnetic", "motion-press", "motion-tilt"],
    code: `<style>
  .obj { display: grid; place-items: center; width: 10rem; aspect-ratio: 1; font-weight: 700; }
  .pull { border-radius: 50%; background: #facc15; }
  .press { border-radius: 1.5rem; background: #60a5fa; }
  .tilt { aspect-ratio: 3 / 4; border-radius: 0.75rem; background: #222230; color: #e8e8f0; }
</style>

<motion-magnetic strength="0.6" bounce="0.5">
  <div class="obj pull">pull</div>
</motion-magnetic>
<motion-press>
  <div class="obj press">press</div>
</motion-press>
<motion-tilt max="18" gloss>
  <div class="obj tilt">tilt</div>
</motion-tilt>`,
  },
  icons: {
    tags: ["motion-icon"],
    code: icons
      .map(([name, animation], i) => `<motion-icon src="${lucide(name)}" animation="${animation}" trigger="view" once="false" delay="${i * 0.08}"></motion-icon>`)
      .join("\n"),
  },
  scroll: {
    tags: ["motion-parallax"],
    code: `<motion-parallax axis="x" depth="0.9"><span>near</span></motion-parallax>
<motion-parallax axis="x" depth="-0.45"><span>middle</span></motion-parallax>
<motion-parallax axis="x" depth="0.15"><span>far away</span></motion-parallax>`,
  },
  components: {
    tags: ["motion-flip-card", "motion-countdown"],
    code: `<motion-flip-card trigger="hover" axis="y" style="width: 14rem; height: 16rem">
  <div slot="front">hover me</div>
  <div slot="back">flipped on a spring</div>
</motion-flip-card>

<p>Until 2027</p>
<motion-countdown to="2027-01-01T00:00:00" format="days hours minutes seconds" roll></motion-countdown>`,
  },
  charts: {
    tags: ["motion-chart", "motion-pie", "motion-sparkline"],
    code: `<motion-chart
  type="line"
  label="Weekly downloads"
  values="1200, 1850, 1600, 2400, 2900, 3300, 4100, 4800"
  labels="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug"
></motion-chart>

<motion-pie
  donut
  label="Visitors by source"
  values="46, 27, 17, 10"
  labels="Search, Direct, Social, Other"
></motion-pie>

<p>
  Downloads grew every month
  <motion-sparkline values="12, 18, 16, 24, 29, 33, 41, 48"></motion-sparkline>
  since January.
</p>`,
  },
  code: {
    tags: ["motion-code"],
    code: `<motion-code filename="index.html" typing typing-speed="45">
  <script type="text/plain">
<motion-tilt max="12" gloss>
  <img src="cover.jpg" alt="Album cover" />
</motion-tilt>

<motion-counter to="9847" suffix="+"></motion-counter>
  </script>
</motion-code>`,
  },
};
---

<Layout
  title="Showcase — Motion Components"
  description="A tour of every motion-components category: text, reveal, respond, icons, scroll, components, charts and code, each live on the page with spring physics."
  noMain>
  <ShowcaseFonts />
  <UnderlineHover />

  <main id="main" class="sc">
    <motion-progress thickness="3" style="--mc-progress-color: var(--mc-color-yellow)"></motion-progress>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-top">
        <motion-blur-in intensity="16" y="10" duration="1" delay="0.9">
          <p class="hero-lede">
            A tour of every component, grouped by what it does, each with real spring physics. Every section below is live: hover it,
            press it, scroll it. Open a category to see all of its components.
          </p>
        </motion-blur-in>
        <nav class="hero-links" aria-label="Get started">
          <motion-stagger interval="0.12" y="14">
            <a href="/docs/"><motion-underline>Read the docs</motion-underline></a>
            <a href="#text"><motion-underline>Start the tour</motion-underline></a>
          </motion-stagger>
        </nav>
      </div>
      <h1 id="hero-title" class="hero-title">
        <motion-font axes="wght:850:250 wdth:62:118" trigger="scroll">
          <span class="hero-line"
            ><motion-parallax axis="x" depth="0.5"
              ><motion-gravity height="260" interval="0.07" bounce="0.5">motion</motion-gravity></motion-parallax
            ></span
          >
          <span class="hero-line hero-line-2"
            ><motion-parallax axis="x" depth="-0.5"
              ><motion-gravity height="260" interval="0.05" bounce="0.5" delay="0.35">components</motion-gravity></motion-parallax
            ></span
          >
        </motion-font>
      </h1>
    </section>

    <div class="tags-band" aria-hidden="true">
      <motion-ticker speed="45" gap="40">
        {allTags.map((t, i) => <span class:list={["tags-band-item", i % 3 === 0 && "tags-band-hot"]}>{t}</span>)}
      </motion-ticker>
    </div>

    {
      categories.map((c) => (
        <section class:list={["gl", `gl-${c.slug}`]} id={c.slug} aria-labelledby={`gl-${c.slug}-title`}>
          <div class="gl-info">
            <motion-parallax depth="0.3">
              <h2 class="gl-title" id={`gl-${c.slug}-title`}>
                <motion-text-mask once="false" duration="1">{c.name}</motion-text-mask>
              </h2>
            </motion-parallax>
            <motion-stagger class="gl-details" interval="0.1" y="18" once="false">
              <p class="gl-blurb">{c.blurb}</p>
              <a class="gl-link" href={categoryHref(c)}>
                <motion-underline>{c.built ? "See them all" : `Read the ${c.name.toLowerCase()} docs`}</motion-underline>
              </a>
            </motion-stagger>
            <ShowcaseCode tags={snippets[c.slug].tags} code={snippets[c.slug].code} />
          </div>
          <motion-blur class="gl-stage" direction="in" intensity="14" y="48" once="false">
            {c.slug === "text" && (
              <div class="st-text">
                <span class="st-text-row st-text-light"><motion-curve amplitude="22" wave-length="360" wave-duration="2.6">curve</motion-curve></span>
                <span class="st-text-row st-text-heavy st-text-end"><motion-glitch trigger="loop" intensity="7">glitch</motion-glitch></span>
                <span class="st-text-row"><motion-perspective depth="0.7" vanish="right" loop>perspective</motion-perspective></span>
                <span class="st-text-row st-text-heavy st-text-end"><motion-liquid intensity="12" duration="6">liquid</motion-liquid></span>
              </div>
            )}
            {c.slug === "reveal" && (
              <div class="st-reveal">
                <motion-blur-in intensity="14" y="18" once="false"><p>Words that wait</p></motion-blur-in>
                <motion-blur-in intensity="14" y="18" duration="0.8" once="false"><p>until you reach them,</p></motion-blur-in>
                <motion-blur-in intensity="14" y="18" duration="0.9" once="false"><p>then come into focus</p></motion-blur-in>
                <motion-blur-in intensity="14" y="18" duration="1" once="false"><p>one line at a time.</p></motion-blur-in>
              </div>
            )}
            {c.slug === "respond" && (
              <div class="st-respond">
                <motion-magnetic strength="0.6" bounce="0.5">
                  <div class="obj obj-pull">pull</div>
                </motion-magnetic>
                <motion-press>
                  <div class="obj obj-press">press</div>
                </motion-press>
                <motion-tilt max="18" gloss>
                  <div class="obj obj-tilt">tilt</div>
                </motion-tilt>
              </div>
            )}
            {c.slug === "icons" && (
              <div class="st-icons">
                {icons.map(([name, animation], i) => (
                  <motion-icon src={lucide(name)} animation={animation} trigger="view" once="false" delay={String(i * 0.08)} />
                ))}
              </div>
            )}
            {c.slug === "scroll" && (
              <div class="st-scroll" aria-hidden="true">
                <motion-parallax axis="x" depth="0.9">
                  <span class="st-near">near</span>
                </motion-parallax>
                <motion-parallax axis="x" depth="-0.45">
                  <span class="st-mid">middle</span>
                </motion-parallax>
                <motion-parallax axis="x" depth="0.15">
                  <span class="st-far">far away</span>
                </motion-parallax>
              </div>
            )}
            {c.slug === "components" && (
              <div class="st-components">
                <motion-flip-card trigger="hover" axis="y" class="st-flip">
                  <div slot="front" class="st-face st-face-front">hover me</div>
                  <div slot="back" class="st-face st-face-back">flipped on a spring</div>
                </motion-flip-card>
                <div class="st-countdown">
                  <p class="st-countdown-label">Until 2027</p>
                  <motion-countdown to="2027-01-01T00:00:00" format="days hours minutes seconds" roll />
                </div>
              </div>
            )}
            {c.slug === "charts" && (
              <div class="st-charts">
                <div class="st-charts-row">
                  <motion-chart
                    type="line"
                    label="Weekly downloads"
                    values="1200, 1850, 1600, 2400, 2900, 3300, 4100, 4800"
                    labels="Jan, Feb, Mar, Apr, May, Jun, Jul, Aug"
                  />
                  <motion-pie donut label="Visitors by source" values="46, 27, 17, 10" labels="Search, Direct, Social, Other" />
                </div>
                <p class="st-spark">
                  Downloads grew every month <motion-sparkline values="12, 18, 16, 24, 29, 33, 41, 48" /> since January.
                </p>
              </div>
            )}
            {c.slug === "code" && <div class="st-code" set:html={code} />}
          </motion-blur>
        </section>
      ))
    }

    <section class="outro" aria-labelledby="outro-title">
      <h2 class="outro-title" id="outro-title">
        <motion-headline by="words" interval="0.08" once="false">All of it starts with one line.</motion-headline>
      </h2>
      <motion-blur-in intensity="18" y="20" once="false">
        <p class="outro-cmd"><motion-code-inline copy-visible>npm install motion-components</motion-code-inline></p>
      </motion-blur-in>
      <p class="outro-note">
        Then import a tag and write HTML. It works in React, Vue, Svelte, Angular, Astro and plain pages.
        <a href={categoryHref(byslug.text)}>Start with the text showcase</a> or <a href="/docs/">the docs</a>.
      </p>
      <p class="outro-note">
        Deep dives: <a href="/showcase/parallax/">parallax</a>, <a href="/showcase/scene/">scroll scenes</a> and
        <a href="/showcase/motion-font/">variable fonts</a>.
      </p>
    </section>
  </main>

  <script>
    import "motion-components/motion-progress";
    import "motion-components/motion-blur";
    import "motion-components/motion-font";
    import "motion-components/motion-gravity";
    import "motion-components/motion-curve";
    import "motion-components/motion-glitch";
    import "motion-components/motion-perspective";
    import "motion-components/motion-liquid";
    import "motion-components/motion-ticker";
    import "motion-components/motion-text-mask";
    import "motion-components/motion-stagger";
    import "motion-components/motion-headline";
    import "motion-components/motion-underline";
    import "motion-components/motion-blur-in";
    import "motion-components/motion-magnetic";
    import "motion-components/motion-press";
    import "motion-components/motion-tilt";
    import "motion-components/motion-icon";
    import "motion-components/motion-parallax";
    import "motion-components/motion-flip-card";
    import "motion-components/motion-countdown";
    import "motion-components/motion-chart";
    import "motion-components/motion-pie";
    import "motion-components/motion-sparkline";
    import "motion-components/motion-code";
    import "motion-components/motion-code-inline";
  </script>

  <style>
    /* Hero */
    .hero {
      box-sizing: border-box;
      min-height: calc(100svh - 56px);
      display: grid;
      grid-template-rows: auto 1fr;
      padding: clamp(2rem, 6vh, 4rem) var(--gutter) clamp(1rem, 3vh, 2rem);
    }

    .hero-top {
      display: grid;
      grid-template-columns: minmax(0, 34rem) auto;
      justify-content: space-between;
      align-items: start;
      gap: 2rem;
    }

    .hero-lede {
      margin: 0;
      font-size: clamp(1rem, 1.3vw, 1.15rem);
      line-height: 1.6;
      color: var(--mc-color-muted);
    }

    .hero-links motion-stagger {
      display: flex;
      gap: 1.75rem;
    }

    .hero-links {
      display: flex;
      font-family: var(--display);
      font-size: 1.25rem;
      font-weight: 600;
    }

    .hero-title {
      align-self: end;
      margin: 0;
      font-family: var(--display);
      font-size: clamp(3.5rem, min(15vw, 26svh), 17rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--mc-color-yellow);
      margin-left: -0.04em;
    }

    .hero-line {
      display: block;
    }

    .hero-title:has(motion-font:not(:defined), motion-gravity:not(:defined)) {
      visibility: hidden;
    }

    .hero-line-2 {
      color: var(--mc-color-text);
    }

    /* Band of every tag */
    .tags-band {
      padding-block: 1.1rem;
      border-block: 1px solid var(--mc-color-border);
      font-family: var(--font-mono);
      font-size: clamp(0.95rem, 1.4vw, 1.2rem);
      color: var(--mc-color-muted);
      white-space: nowrap;
    }

    .tags-band-hot {
      color: var(--mc-color-yellow);
    }

    /* Glimpses */
    .gl {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
      padding: clamp(5rem, 14vh, 9rem) var(--gutter);
      border-top: 1px solid var(--mc-color-border);
    }

    .gl:nth-of-type(odd) {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }

    .gl:nth-of-type(odd) .gl-info {
      order: 2;
    }

    .gl-title {
      margin: 0;
      font-family: var(--display);
      font-size: clamp(3.25rem, 8vw, 7.5rem);
      font-weight: 800;
      font-variation-settings: "wdth" 60, "opsz" 96;
      line-height: 0.9;
      letter-spacing: -0.02em;
    }

    .gl-details {
      display: block;
    }


    .gl-blurb {
      max-width: 26rem;
      margin: 1rem 0 1.5rem;
      font-size: 1.05rem;
      line-height: 1.6;
      color: var(--mc-color-muted);
    }

    .gl-link {
      font-family: var(--display);
      font-size: 1.2rem;
      font-weight: 600;
    }

    .gl-stage {
      display: block;
      min-width: 0;
    }

    /* Text */
    .st-text {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-family: var(--display);
      font-size: clamp(3rem, 9vw, 9rem);
      font-weight: 700;
      font-variation-settings: "wdth" 75, "opsz" 96;
      line-height: 1;
    }

    .st-text-row {
      display: flex;
      align-items: flex-end;
      height: 1.05em;
    }

    .st-text {
      font-size: clamp(2.5rem, 7vw, 7rem);
    }

    .st-text-light {
      font-weight: 300;
      font-variation-settings: "wdth" 125, "opsz" 96;
    }

    .st-text-end {
      justify-content: flex-end;
    }

    .st-text-heavy {
      font-weight: 800;
      font-variation-settings: "wdth" 60, "opsz" 96;
    }

    /* Reveal */
    .st-reveal p {
      margin: 0;
      font-family: var(--display);
      font-size: clamp(2rem, 4.6vw, 4.5rem);
      font-weight: 600;
      font-variation-settings: "wdth" 75, "opsz" 72;
      line-height: 1.1;
      letter-spacing: -0.015em;
    }

    .st-reveal motion-blur-in:nth-child(even) p {
      color: var(--mc-color-muted);
    }

    /* Respond */
    .st-respond {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-around;
      gap: 2.5rem;
      padding-block: 1rem;
    }

    .obj {
      display: grid;
      place-items: center;
      font-family: var(--display);
      font-size: clamp(1.25rem, 2.2vw, 1.75rem);
      font-weight: 700;
      user-select: none;
    }

    .obj-pull {
      width: clamp(8rem, 13vw, 12rem);
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--mc-color-yellow);
      color: var(--mc-color-bg);
    }

    .obj-press {
      width: clamp(8rem, 13vw, 12rem);
      aspect-ratio: 1;
      border-radius: 1.5rem;
      background: var(--mc-color-accent);
      color: var(--mc-color-bg);
      cursor: pointer;
    }

    .obj-tilt {
      width: clamp(8rem, 12vw, 11rem);
      aspect-ratio: 3 / 4;
      border-radius: 0.75rem;
      background: var(--mc-color-surface-2);
      border: 1px solid var(--mc-color-border);
      color: var(--mc-color-text);
    }

    /* Icons */
    .st-icons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      justify-items: center;
      --mc-icon-size: clamp(3rem, 6vw, 5.5rem);
      color: var(--mc-color-text);
    }

    .st-icons motion-icon:nth-child(3n + 1) {
      color: var(--mc-color-yellow);
    }

    .st-icons motion-icon:nth-child(4n + 2) {
      color: var(--mc-color-accent);
    }

    /* Scroll */
    .st-scroll {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-family: var(--display);
      font-weight: 800;
      font-variation-settings: "wdth" 60, "opsz" 96;
      line-height: 1;
      white-space: nowrap;
    }

    .st-near {
      display: block;
      font-size: clamp(4rem, 11vw, 10rem);
      color: var(--mc-color-yellow);
    }

    .st-mid {
      display: block;
      font-size: clamp(2.5rem, 6vw, 5.5rem);
      padding-left: 18%;
    }

    .st-far {
      display: block;
      font-size: clamp(1.5rem, 3vw, 2.75rem);
      padding-left: 45%;
      color: var(--mc-color-muted);
    }

    /* Components */
    .st-components {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: clamp(2rem, 5vw, 4rem);
    }

    .st-flip {
      width: clamp(12rem, 18vw, 16rem);
      height: clamp(14rem, 21vw, 19rem);
    }

    .st-face {
      box-sizing: border-box;
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      padding: 1.5rem;
      border-radius: 1rem;
      font-family: var(--display);
      font-size: 1.6rem;
      font-weight: 700;
      text-align: center;
      line-height: 1.1;
    }

    .st-face-front {
      background: var(--mc-color-yellow);
      color: var(--mc-color-bg);
    }

    .st-face-back {
      background: var(--mc-color-accent);
      color: var(--mc-color-bg);
    }

    .st-countdown-label {
      margin: 0 0 0.75rem;
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 400;
      color: var(--mc-color-muted);
    }

    .st-countdown {
      --mc-countdown-size: clamp(1.6rem, 10.5vw, 3.5rem);
      --mc-countdown-gap: clamp(0.3rem, 1.8vw, 0.75rem);
      max-width: 100%;
      font-family: var(--display);
      font-size: clamp(1.15rem, 5.4vw, 2.5rem);
      font-weight: 700;
    }

    /* Charts */
    .st-charts-row {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .st-charts motion-chart {
      display: block;
      width: 100%;
      --mc-chart-color: var(--mc-color-accent);
    }

    .st-charts motion-pie {
      display: block;
      width: 100%;
      --mc-chart-1: var(--mc-color-accent);
      --mc-chart-2: var(--mc-color-yellow);
      --mc-chart-3: var(--mc-color-muted);
      --mc-chart-4: var(--mc-color-text);
      --mc-chart-surface: var(--mc-color-bg);
    }

    @media (max-width: 860px) {
      .st-charts-row {
        grid-template-columns: 1fr;
      }
    }

    .st-spark {
      margin: 1.5rem 0 0;
      font-size: 1.1rem;
      color: var(--mc-color-muted);
    }

    .st-spark motion-sparkline {
      --mc-sparkline-color: var(--mc-color-yellow);
    }

    /* Code */
    .st-code {
      max-width: 44rem;
    }

    /* Outro */
    .outro {
