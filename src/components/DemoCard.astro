---
interface Props {
  wide?: boolean;
  tall?: boolean;
  noPad?: boolean;
  dark?: boolean;
  compact?: boolean;
  showBar?: boolean;
}
const { wide, tall, noPad, dark, compact, showBar = false } = Astro.props;
---

<div class="demo-wrap">
  <div class:list={["demo-stage", { wide, tall, "no-pad": noPad, dark, compact }]}>
    <slot name="default" />
  </div>
  {showBar && (
    <div class="demo-bar">
      <slot name="bar" />
    </div>
  )}
</div>

<style>
  .demo-wrap {
    display: block;
    border: 1px solid var(--mc-color-border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .demo-stage {
    background: var(--mc-color-surface);
    padding: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140px;
  }

  .demo-stage.wide {
    padding: 2rem;
  }

  .demo-stage.compact {
    padding: 1.5rem;
    min-height: 0;
  }

  .demo-stage.tall {
    padding: 4rem 0;
  }

  .demo-stage.dark {
    background: #0a0a0f;
  }

  .demo-stage.no-pad {
    padding: 0;
    display: block;
  }

  @media (max-width: 640px) {
    .demo-stage,
    .demo-stage.wide {
      padding: 1.5rem 1rem;
    }
  }

  .demo-bar {
    background: var(--mc-color-surface-2);
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--mc-color-border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
