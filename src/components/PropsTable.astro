---
/**
 * Prop tables for documentation pages, rendered by DocsTable so they look the
 * same as the hand-written method, event and format tables they replaced.
 */
import DocsTable from "./DocsTable.astro";

interface PropRow {
  name: string;
  type: string;
  default: string;
  description: string;
  property?: string;
}

interface Props {
  rows: PropRow[];
  nameLabel?: string;
}

const { rows, nameLabel = "Property" } = Astro.props;

const showPropertyColumn = nameLabel === "Attribute";

const kebabToCamel = (s: string) => s.replace(/-([a-z0-9])/g, (_, c: string) => c.toUpperCase());

const columns = [
  ...(showPropertyColumn ? [{ label: "Attribute" }, { label: "Property" }] : [{ label: nameLabel }]),
  { label: "Type", mono: true, nowrap: true },
  { label: "Default", mono: true, nowrap: true },
  { label: "Description" },
];

const tableRows = rows.map((row) => [
  ...(showPropertyColumn
    ? [{ code: row.name }, { code: row.property ?? kebabToCamel(row.name) }]
    : [{ code: row.name }]),
  row.type,
  row.default,
  { html: row.description },
]);
---

<DocsTable columns={columns} rows={tableRows} />