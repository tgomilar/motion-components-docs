---
import DemoCard from "./DemoCard.astro";

interface Props {
  replayId?: string;
  wide?: boolean;
  tall?: boolean;
  noPad?: boolean;
  dark?: boolean;
  compact?: boolean;
}
const { replayId, wide, tall, noPad, dark, compact } = Astro.props;
---

<DemoCard {wide} {tall} {noPad} {dark} {compact} showBar={!!replayId}>
  <slot />
  {replayId && (
    <button slot="bar" class="replay-btn" data-replay={replayId}>
      ↺ Replay
    </button>
  )}
</DemoCard>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-replay]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = document.getElementById(btn.dataset.replay!) as any;
      if (!target) return;
      if (typeof target.replay === "function") {
        target.replay();
      } else {
        // id on a wrapper — replay every replayable element inside it
        target.querySelectorAll("*").forEach((el: any) => {
          if (typeof el.replay === "function") el.replay();
        });
      }
    });
  });
</script>

<style>
  .replay-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .replay-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
