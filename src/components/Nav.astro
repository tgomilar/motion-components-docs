---
import Search from "./Search.astro";

const { pathname } = Astro.url;
---

<header data-pagefind-ignore="all">
  <nav>
    <a href="/" class="logo"
      ><span class="logo-bracket">&lt;</span><span class="logo-motion">motion</span><span class="logo-dash">-</span><span class="logo-comp">components</span
      ><span class="logo-bracket">&gt;</span></a
    >
    <Search />
    <button class="hamburger" id="hamburger" aria-label="Menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <div class="links" id="nav-links">
      <a href="/docs/" class:list={["link", { active: pathname.startsWith("/docs") }]}>Docs</a>
      <a href="/blog/" class:list={["link", { active: pathname.startsWith("/blog") }]}>Blog</a>
      <a href="/about/" class:list={["link", { active: pathname === "/about" || pathname === "/about/" }]}>About</a>
      <a href="https://github.com/tgomilar/motion-components" class="link" target="_blank" rel="noopener">GitHub</a>
      <motion-theme-toggle id="theme-toggle" appearance="menu" system permanent legend="Theme"></motion-theme-toggle>
    </div>
  </nav>
</header>

<script>
  import "motion-components/motion-theme-toggle";

  const header = document.querySelector("header");
  if (header) {
    window.addEventListener(
      "scroll",
      () => {
        header.classList.toggle("scrolled", window.scrollY > 8);
      },
      { passive: true },
    );
  }

  /* ── Hamburger ── */
  const hamburger = document.getElementById("hamburger");
  const navLinks = document.getElementById("nav-links");

  if (hamburger && navLinks) {
    function closeNav() {
      navLinks!.classList.remove("open");
      hamburger!.setAttribute("aria-expanded", "false");
      document.body.classList.remove("nav-open");
    }

    hamburger.addEventListener("click", e => {
      e.stopPropagation();
      const open = navLinks.classList.toggle("open");
      hamburger.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("nav-open", open);
    });

    navLinks.querySelectorAll("a").forEach(a => {
      a.addEventListener("click", closeNav);
    });

    // Close when clicking outside the drawer (e.g. on the backdrop)
    document.addEventListener("click", e => {
      if (!navLinks.classList.contains("open")) return;
      if (navLinks.contains(e.target as Node)) return;
      closeNav();
    });

    // Close on Escape
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") closeNav();
    });
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--mc-color-bg);
    border-bottom: 1px solid var(--mc-color-border);
    transition:
      background 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }

  header.scrolled {
    background: color-mix(in srgb, var(--mc-color-bg) 65%, transparent);
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    border-bottom-color: color-mix(in srgb, var(--mc-color-border) 50%, transparent);
    box-shadow:
      inset 0 -1px 0 rgba(255, 255, 255, 0.04),
      0 4px 12px rgba(0, 0, 0, 0.04);
  }

  nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  .logo-bracket {
    color: var(--mc-color-yellow);
  }
  .logo-bracket:first-child {
    margin-right: 0.15em;
  }
  .logo-bracket:last-child {
    margin-left: 0.15em;
  }
  .logo-motion {
    color: var(--mc-color-accent);
  }
  .logo-dash {
    color: var(--mc-color-yellow);
  }
  .logo-comp {
    color: var(--mc-color-accent);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .link {
    font-size: 0.9rem;
    color: var(--mc-color-muted);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .link:hover {
    color: var(--mc-color-text);
    background: var(--mc-color-surface-2);
    text-decoration: none;
  }

  .link.active {
    color: var(--mc-color-text);
    font-weight: 500;
  }

  #theme-toggle {
    min-width: 32px;
    min-height: 32px;
    color: var(--mc-color-muted);
    font-size: 0.875rem;
    --mc-theme-toggle-surface: transparent;
    --mc-theme-toggle-border: var(--mc-color-border);
    --mc-theme-toggle-accent: var(--mc-color-accent-dim);
    --mc-theme-toggle-menu-bg: var(--mc-color-surface);
    --mc-theme-icon-size: 16px;
  }

  #theme-toggle::part(button) {
    width: 32px;
    height: 32px;
    border-radius: 6px;
  }

  #theme-toggle::part(button):hover {
    color: var(--mc-color-text);
    background: var(--mc-color-surface-2);
  }

  #theme-toggle::part(menu) {
    color: var(--mc-color-text);
  }

  /* ── Hamburger ── */
  .hamburger {
    all: unset;
    display: none;
    width: 32px;
    height: 32px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
    position: relative;
    z-index: 60;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--mc-color-text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  @media (max-width: 640px) {
    nav {
      padding: 0 1rem;
      gap: 0.5rem;
    }

    .hamburger {
      display: flex;
    }

    .links {
      position: fixed;
      top: 56px;
      right: 0;
      /* The header gets `backdrop-filter` on scroll, which makes it the
         containing block for this fixed drawer — so `bottom: 0` would
         resolve against the 56px header and collapse it. Size by height
         instead; `dvh` stays viewport-relative regardless. */
      height: calc(100dvh - 56px);
      width: 260px;
      background: var(--mc-color-surface);
      border-left: 1px solid var(--mc-color-border);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.75rem;
      transform: translateX(100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 55;
      box-shadow: -8px 0 24px rgba(0,0,0,0.08);
    }

    .links.open {
      transform: translateX(0);
    }

    .link {
      padding: 0.65rem 0.75rem;
      border-radius: 8px;
    }

    #theme-toggle {
      margin: 0.5rem 0.75rem 0;
      align-self: flex-start;
    }

    #theme-toggle::part(menu) {
      inset-inline-start: 0;
      inset-inline-end: auto;
    }

    .logo {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 640px) {
    body.nav-open::after {
      content: "";
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.3);
        z-index: 45;
    }
  }
</style>
