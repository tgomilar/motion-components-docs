<button class="search-trigger" id="search-trigger" type="button" aria-label="Search" aria-keyshortcuts="Meta+K Control+K /">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="search-trigger-label">Search</span>
  <kbd class="search-trigger-kbd" data-search-kbd>⌘K</kbd>
</button>

<motion-dialog id="search-dialog" class="search-dialog" light-dismiss y="16" duration="0.35" bounce="0.15" data-pagefind-ignore="all">
  <div class="search-panel">
    <div class="search-field">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search components, recipes and posts"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-label="Search the site"
      />
      <kbd class="search-esc">Esc</kbd>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Search results"></ul>
    <p class="search-status" id="search-status" aria-live="polite"></p>
  </div>
</motion-dialog>

<script>
  import "motion-components/motion-dialog";
  type SubResult = { title: string; url: string; excerpt: string };
  type ResultData = { url: string; excerpt: string; meta: { title?: string }; sub_results?: SubResult[] };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<ResultData> }[] } | null>;
  };

  const trigger = document.getElementById("search-trigger");
  const dialog = document.getElementById("search-dialog") as (HTMLElement & { show(): void; close(): void; open: boolean }) | null;
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const list = document.getElementById("search-results");
  const status = document.getElementById("search-status");

  const SECTIONS: [RegExp, string][] = [
    [/^\/docs\/recipes\//, "Recipe"],
    [/^\/docs\//, "Docs"],
    [/^\/blog\//, "Blog"],
    [/^\/showcase\//, "Showcase"],
  ];

  let pagefind: Pagefind | null = null;
  let active = -1;

  const shortcut = /Mac|iPhone|iPad/.test(navigator.platform) ? "⌘K" : "Ctrl K";
  document.querySelectorAll("[data-search-kbd]").forEach((el) => (el.textContent = shortcut));

  async function loadIndex() {
    if (pagefind) return pagefind;
    const url = "/pagefind/pagefind.js";
    pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
    await pagefind.options({ excerptLength: 16 });
    return pagefind;
  }

  function sectionFor(url: string) {
    return SECTIONS.find(([re]) => re.test(url))?.[1] ?? "Page";
  }

  function options() {
    return [...(list?.querySelectorAll<HTMLAnchorElement>("[role=option]") ?? [])];
  }

  function setActive(index: number) {
    const items = options();
    if (!items.length || !input) return;
    active = (index + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute("aria-selected", String(i === active)));
    input.setAttribute("aria-activedescendant", items[active].id);
    items[active].scrollIntoView({ block: "nearest" });
  }

  function option(id: string, href: string, title: string, excerpt: string, label?: string, nested = false) {
    const li = document.createElement("li");
    const a = document.createElement("a");
    a.id = id;
    a.href = href;
    a.className = nested ? "search-hit search-hit--sub" : "search-hit";
    a.setAttribute("role", "option");
    a.setAttribute("aria-selected", "false");
    const head = document.createElement("span");
    head.className = "search-hit-head";
    if (label) {
      const tag = document.createElement("span");
      tag.className = "search-hit-tag";
      tag.textContent = label;
      head.append(tag);
    }
    const name = document.createElement("span");
    name.className = "search-hit-title";
    name.textContent = title;
    head.append(name);
    const body = document.createElement("span");
    body.className = "search-hit-excerpt";
    body.innerHTML = excerpt;
    a.append(head, body);
    li.append(a);
    return li;
  }

  async function run(query: string) {
    if (!list || !status || !input) return;
    const q = query.trim();
    if (!q) {
      list.replaceChildren();
      status.textContent = "";
      input.setAttribute("aria-expanded", "false");
      return;
    }
    let index: Pagefind;
    try {
      index = await loadIndex();
    } catch {
      status.textContent = "Search is available in the built site. Run npm run build, then npm run preview.";
      return;
    }
    const search = await index.debouncedSearch(q, {}, 150);
    if (!search) return;
    const hits = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
    if (input.value.trim() !== q) return;
    const items: HTMLLIElement[] = [];
    hits.forEach((hit, i) => {
      const title = hit.meta.title ?? hit.url;
      items.push(option(`search-hit-${i}`, hit.url, title, hit.excerpt, sectionFor(hit.url)));
      (hit.sub_results ?? [])
        .filter((sub) => sub.url.includes("#") && sub.title !== title)
        .slice(0, 2)
        .forEach((sub, j) => items.push(option(`search-hit-${i}-${j}`, sub.url, sub.title, sub.excerpt, undefined, true)));
    });
    list.replaceChildren(...items);
    input.setAttribute("aria-expanded", String(items.length > 0));
    input.removeAttribute("aria-activedescendant");
    active = -1;
    status.textContent = items.length ? `${hits.length} ${hits.length === 1 ? "page" : "pages"} found` : `No results for “${q}”`;
    if (items.length) setActive(0);
  }

  function open() {
    if (!dialog || dialog.open) return;
    dialog.show();
    requestAnimationFrame(() => input?.focus());
    loadIndex().catch(() => {});
  }

  trigger?.addEventListener("click", open);

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    const typing = target.closest("input, textarea, select, [contenteditable='true']");
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (dialog?.open) dialog.close();
      else open();
    } else if (e.key === "/" && !typing && !dialog?.open) {
      e.preventDefault();
      open();
    }
  });

  input?.addEventListener("input", () => run(input.value));

  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") setActive(active + 1);
    else if (e.key === "ArrowUp") setActive(active - 1);
    else if (e.key === "Enter" && active >= 0) options()[active]?.click();
    else if (e.key === "Escape") dialog?.close();
    else return;
    e.preventDefault();
  });

  list?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) dialog?.close();
  });
</script>

<style>
  .search-trigger {
    all: unset;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 32px;
    padding: 0 0.5rem 0 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-muted);
    font-size: 0.85rem;
    cursor: pointer;
    background: var(--color-surface);
    min-width: 11rem;
    box-sizing: border-box;
  }

  .search-trigger:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .search-trigger-label {
    flex: 1;
  }

  .search-trigger-kbd,
  .search-esc {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    color: var(--color-muted);
    background: var(--color-surface-2);
  }

  @media (max-width: 640px) {
    .search-trigger {
      min-width: 0;
      width: 32px;
      padding: 0;
      justify-content: center;
    }

    .search-trigger-label,
    .search-trigger-kbd {
      display: none;
    }
  }

  .search-dialog {
    --dialog-padding: 0;
    --dialog-radius: 14px;
    --dialog-max-width: min(640px, calc(100vw - 2rem));
    --dialog-bg: var(--color-surface);
    --dialog-color: var(--color-text);
    --dialog-backdrop-color: rgba(10, 10, 20, 0.35);
    --dialog-backdrop-blur: blur(3px);
  }

  .search-panel {
    width: min(640px, calc(100vw - 2rem));
    display: flex;
    flex-direction: column;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .search-field input {
    all: unset;
    flex: 1;
    font-size: 1rem;
    color: var(--color-text);
  }

  .search-field input::placeholder {
    color: var(--color-muted);
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    height: min(26rem, 60dvh);
    overflow-y: auto;
  }

  .search-results:empty {
    height: 0;
    padding: 0;
  }

  .search-results :global(.search-hit) {
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    color: var(--color-text);
    text-decoration: none;
  }

  .search-results :global(.search-hit--sub) {
    margin-left: 1.25rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-border);
    border-radius: 0 8px 8px 0;
  }

  .search-results :global(.search-hit[aria-selected="true"]) {
    background: var(--color-accent-dim);
  }

  .search-results :global(.search-hit-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .search-results :global(.search-hit-tag) {
    flex: none;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .search-results :global(.search-hit-title) {
    font-weight: 600;
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.search-hit-excerpt) {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-results :global(mark) {
    background: none;
    color: var(--color-accent);
    font-weight: 600;
  }

  .search-status {
    margin: 0;
    padding: 0.6rem 1rem;
    font-size: 0.78rem;
    color: var(--color-muted);
    border-top: 1px solid var(--color-border);
    max-width: none;
  }

  .search-status:empty {
    display: none;
  }
</style>
