---
interface Props {
  id?: string;
  filename?: string;
  lang?: string;
  copy?: boolean;
  "copy-label"?: boolean;
  compact?: boolean;
  "hide-chrome"?: boolean;
  typing?: boolean;
  typingSpeed?: number;
  typingDelay?: number;
  typingLoop?: boolean;
  typingHold?: number;
  code: string;
}

const {
  id: customId,
  filename = "app.html",
  lang = "",
  copy = false,
  "copy-label": copyLabel = false,
  compact = false,
  "hide-chrome": hideChrome = false,
  typing = false,
  typingSpeed,
  typingDelay,
  typingLoop = true,
  typingHold,
  code,
} = Astro.props;

const elId = customId ?? `cw-${Math.random().toString(36).slice(2, 9)}`;
---

<motion-code
  id={elId}
  filename={filename}
  code-lang={lang || undefined}
  copy={copy || undefined}
  copy-label={copyLabel || undefined}
  compact={compact || undefined}
  hide-chrome={hideChrome || undefined}
  typing={typing || undefined}
  typing-speed={typingSpeed}
  typing-delay={typingDelay}
  typing-loop={typingLoop ? undefined : "false"}
  typing-hold={typingHold}
></motion-code>

<script define:vars={{ elId, code }}>
  customElements.whenDefined("motion-code").then(() => {
    const el = document.getElementById(elId);
    if (!el) return;
    el.setCode(code);
  });
</script>
